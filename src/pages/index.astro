---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import CountdownSection from '../components/CountdownSection.astro';
import OurStorySection from '../components/OurStorySection.astro';
import LetterPullSection from '../components/LetterPullSection.astro';
import FaqSection from '../components/FaqSection.astro';
import WeddingChatRSVP from '../components/WeddingChatRSVP.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
	<Header />
	<main>
		<Hero />
		<CountdownSection />
		<OurStorySection />
		<LetterPullSection />
		<WeddingChatRSVP />
		<section id="boquete" aria-label="Boquete"></section>
		<FaqSection />
	</main>
	<Footer />
</Layout>
