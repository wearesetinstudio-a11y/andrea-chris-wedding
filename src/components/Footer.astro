---
const contacts = [
	{
		label: 'Whatsapp Andrea',
		value: '(+507) 6997 9321',
		href: 'https://wa.me/50769979321',
		external: true,
	},
	{
		label: 'Correo Andrea',
		value: 'vega21andrea@gmail.com',
		href: 'mailto:vega21andrea@gmail.com',
		external: false,
	},
	{
		label: 'Whatsapp Chris',
		value: '(+507) 6628 6524',
		href: 'https://wa.me/50766286524',
		external: true,
	},
	{
		label: 'Correo Chris',
		value: 'k4bartosik@gmail.com',
		href: 'mailto:k4bartosik@gmail.com',
		external: false,
	},
] as const;
---

<footer id="contact" class="footer bg-section text-white" aria-labelledby="footer-heading">
	<div class="footer__inner">
		<h2
			id="footer-heading"
			class="font-serif text-[1.85rem] leading-tight text-white md:text-3xl lg:text-[2.15rem]"
			data-reveal
		>
			¡Contáctanos para cualquier duda!
		</h2>

		<div
			class="mt-8 flex flex-col gap-6 md:mt-10 md:flex-row md:items-center md:justify-between md:gap-6 lg:gap-8"
		>
			<p class="shrink-0 font-serif text-xl leading-none text-white md:text-[1.35rem]">
				Andrea &amp; Chris
			</p>

			<ul
				class="m-0 flex list-none flex-col p-0 md:flex-1 md:flex-row md:items-stretch md:justify-end md:gap-0"
				role="list"
			>
				{
					contacts.map((item) => (
						<li class="footer__item border-b border-white/10 py-4 first:pt-0 last:border-b-0 last:pb-0 md:border-b-0 md:border-l md:border-white/20 md:px-5 md:py-0 lg:px-7">
							<span class="mb-1 block font-sans text-xs text-white/60">{item.label}</span>
							<a
								href={item.href}
								class="font-sans text-sm font-medium text-white transition-opacity hover:underline"
								{...(item.external
									? { target: '_blank', rel: 'noopener noreferrer' }
									: {})}
							>
								{item.value}
							</a>
						</li>
					))
				}
			</ul>
		</div>

		{/* Divider spans the content grid only */}
		<hr class="footer__rule" />

		<div class="footer__meta">
			<p class="m-0 font-sans text-xs text-white/60">
				©2026 Andrea &amp; Chris&nbsp;&nbsp;&nbsp;All Rights Reserved
			</p>

			<p class="footer__credit m-0 inline-flex items-center gap-2 font-sans text-xs leading-none text-white/60">
				<span>Crafted with Love by</span>
				<a
					href="https://www.wearesetin.com/"
					target="_blank"
					rel="noopener noreferrer"
					class="footer__logo-link opacity-60 transition-opacity hover:opacity-100"
					aria-label="setin studio"
				>
					<img
						src="/setin-studio-logo.svg"
						alt=""
						width="71"
						height="12"
						class="footer__logo"
					/>
				</a>
			</p>
		</div>
	</div>
</footer>

<style>
	/* Match FAQ / RSVP horizontal inset */
	.footer__inner {
		width: 100%;
		padding: 4.5rem 1.15rem 3.5rem;
	}

	.footer__rule {
		margin: 2.75rem 0;
		border: 0;
		border-top: 1px solid rgb(255 255 255 / 0.18);
		width: 100%;
	}

	.footer__meta {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		text-align: center;
	}

	.footer__logo-link {
		display: inline-flex;
		align-items: center;
		line-height: 0;
	}

	/* Slightly taller than text-xs, nudged up for optical baseline match */
	.footer__logo {
		display: block;
		height: 0.875rem;
		width: auto;
		translate: 0 -0.06em;
	}

	@media (min-width: 768px) {
		.footer__inner {
			padding: 6rem 1.5rem 4.5rem;
		}

		.footer__rule {
			margin: 3.8rem 0;
		}

		.footer__meta {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			gap: 1rem;
			text-align: left;
		}

		.footer__logo {
			height: 0.9375rem;
		}
	}

	@media (min-width: 900px) {
		.footer__inner {
			padding-inline: max(1.5rem, 2.75vw);
		}
	}
</style>
