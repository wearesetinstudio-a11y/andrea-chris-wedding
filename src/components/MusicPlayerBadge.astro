---
import fs from 'node:fs';
import path from 'node:path';

/**
 * Spotify track: Heaven (Instrumental Piano)
 * https://open.spotify.com/track/2mObUHGH15TBKVL2VSxIkG
 * Prefer full local file at public/music/heaven.mp3 (Spotify preview is only ~30s).
 */
const FULL_TRACK = '/music/heaven.mp3';
const PREVIEW_URL = 'https://p.scdn.co/mp3-preview/2e5cb9a254dd7885811bea49d525affac396f4a0';

const fullTrackPath = path.join(process.cwd(), 'public', 'music', 'heaven.mp3');
const audioSrc = fs.existsSync(fullTrackPath) ? FULL_TRACK : PREVIEW_URL;
---

<div class="music-eq" data-music-player>
	<button
		type="button"
		class="music-eq__toggle"
		aria-pressed="false"
		aria-label="Reproducir música"
		data-music-toggle
	>
		<span class="music-eq__bars" aria-hidden="true" data-music-bars>
			<span class="music-eq__bar" data-bar style="--bar-from: 35%; --bar-to: 100%; --bar-duration: 0.42s"></span>
			<span class="music-eq__bar" data-bar style="--bar-from: 55%; --bar-to: 100%; --bar-duration: 0.56s"></span>
			<span class="music-eq__bar" data-bar style="--bar-from: 40%; --bar-to: 90%; --bar-duration: 0.48s"></span>
			<span class="music-eq__bar" data-bar style="--bar-from: 25%; --bar-to: 75%; --bar-duration: 0.38s"></span>
			<span class="music-eq__bar" data-bar style="--bar-from: 45%; --bar-to: 95%; --bar-duration: 0.52s"></span>
		</span>
	</button>

	<audio data-music-audio src={audioSrc} preload="auto" playsinline loop></audio>
</div>

<style>
	.music-eq {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}

	.music-eq__toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		margin: 0;
		padding: 0;
		border: 0;
		border-radius: 0.25rem;
		background: transparent;
		color: var(--color-accent);
		cursor: pointer;
	}

	.music-eq__toggle:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
	}

	.music-eq__bars {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.14rem;
		height: 0.95rem;
	}

	.music-eq__bar {
		display: block;
		width: 0.18rem;
		height: 0.18rem;
		border-radius: 0.03rem;
		background: currentColor;
		transform-origin: center bottom;
		will-change: height;
	}

	.music-eq:not(.is-playing) .music-eq__bar {
		width: 0.18rem;
		height: 0.18rem;
		border-radius: 0.03rem;
		animation: none;
	}

	.music-eq.is-playing .music-eq__bars {
		align-items: flex-end;
	}

	.music-eq.is-playing .music-eq__bar {
		width: 0.14rem;
		border-radius: 999px;
	}

	.music-eq audio {
		position: absolute;
		width: 0;
		height: 0;
		opacity: 0;
		pointer-events: none;
	}
</style>

<style is:global>
	@keyframes music-eq-bounce {
		0% {
			height: var(--bar-from, 35%);
		}
		100% {
			height: var(--bar-to, 100%);
		}
	}

	.music-eq-bar-animating {
		animation: music-eq-bounce var(--bar-duration, 0.5s) ease-in-out infinite alternate;
	}

	@media (prefers-reduced-motion: reduce) {
		.music-eq-bar-animating {
			animation: none;
			height: var(--bar-to, 80%);
		}
	}
</style>

<script>
	type WeddingMusicApi = {
		play: () => Promise<void>;
		pause: () => void;
		toggle: () => Promise<void>;
	};

	const root = document.querySelector<HTMLElement>('[data-music-player]');
	const toggle = root?.querySelector<HTMLButtonElement>('[data-music-toggle]');
	const audio = root?.querySelector<HTMLAudioElement>('[data-music-audio]');
	const bars = root ? Array.from(root.querySelectorAll<HTMLElement>('[data-bar]')) : [];

	if (root && toggle && audio) {
		const setPlaying = (next: boolean) => {
			root.classList.toggle('is-playing', next);
			toggle.setAttribute('aria-pressed', next ? 'true' : 'false');
			toggle.setAttribute('aria-label', next ? 'Pausar música' : 'Reproducir música');

			bars.forEach((bar, index) => {
				if (next) {
					bar.style.animationDelay = `${index * 70}ms`;
					bar.style.height = '';
					bar.classList.add('music-eq-bar-animating');
				} else {
					bar.classList.remove('music-eq-bar-animating');
					bar.style.animationDelay = '';
					bar.style.height = '';
				}
			});
		};

		const playMusic = async () => {
			try {
				audio.loop = true;
				await audio.play();
				setPlaying(true);
			} catch (error) {
				console.error('Music playback failed', error);
				setPlaying(false);
			}
		};

		const pauseMusic = () => {
			audio.pause();
			setPlaying(false);
		};

		const toggleMusic = async () => {
			if (audio.paused) await playMusic();
			else pauseMusic();
		};

		audio.addEventListener('play', () => setPlaying(true));
		audio.addEventListener('pause', () => {
			if (!audio.ended) setPlaying(false);
		});

		// Always restart when a track ends so music keeps going.
		audio.addEventListener('ended', () => {
			audio.currentTime = 0;
			void playMusic();
		});

		toggle.addEventListener('click', () => {
			void toggleMusic();
		});

		// Start when the envelope intro is tapped open.
		window.addEventListener('wedding:start-music', () => {
			void playMusic();
		});

		(window as Window & { __weddingMusic?: WeddingMusicApi }).__weddingMusic = {
			play: playMusic,
			pause: pauseMusic,
			toggle: toggleMusic,
		};
	}
</script>
