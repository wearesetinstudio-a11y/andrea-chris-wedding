---
/**
 * Heaven / Bryan Adams — Solo Piano (Kiran Podmore)
 * https://soundcloud.com/kiranpodmoremusic/heaven-bryan-adams-solo-piano
 */
const TRACK_URL = 'https://soundcloud.com/kiranpodmoremusic/heaven-bryan-adams-solo-piano';
const WIDGET_SRC = `https://w.soundcloud.com/player/?url=${encodeURIComponent(TRACK_URL)}&auto_play=false&hide_related=true&show_comments=false&show_user=false&show_reposts=false&show_teaser=false&visual=false`;
---

<div class="music-eq" data-music-player>
	<button
		type="button"
		class="music-eq__toggle"
		aria-pressed="false"
		aria-label="Reproducir música"
		data-music-toggle
	>
		<svg
			class="music-eq__bars"
			width="38"
			height="16"
			viewBox="0 0 38 16"
			aria-hidden="true"
			data-music-bars
			shape-rendering="crispEdges"
		>
			<rect class="music-eq__bar" data-bar x="0" y="7" width="2" height="2" style="--bar-from: 4; --bar-to: 14; --bar-duration: 0.42s"></rect>
			<rect class="music-eq__bar" data-bar x="5" y="7" width="2" height="2" style="--bar-from: 6; --bar-to: 16; --bar-duration: 0.56s"></rect>
			<rect class="music-eq__bar" data-bar x="10" y="7" width="2" height="2" style="--bar-from: 4; --bar-to: 12; --bar-duration: 0.48s"></rect>
			<rect class="music-eq__bar" data-bar x="15" y="7" width="2" height="2" style="--bar-from: 2; --bar-to: 10; --bar-duration: 0.38s"></rect>
			<rect class="music-eq__bar" data-bar x="20" y="7" width="2" height="2" style="--bar-from: 6; --bar-to: 16; --bar-duration: 0.52s"></rect>
			<rect class="music-eq__bar" data-bar x="25" y="7" width="2" height="2" style="--bar-from: 4; --bar-to: 12; --bar-duration: 0.44s"></rect>
			<rect class="music-eq__bar" data-bar x="30" y="7" width="2" height="2" style="--bar-from: 8; --bar-to: 16; --bar-duration: 0.58s"></rect>
			<rect class="music-eq__bar" data-bar x="35" y="7" width="2" height="2" style="--bar-from: 4; --bar-to: 14; --bar-duration: 0.46s"></rect>
		</svg>
	</button>

	<iframe
		class="music-eq__widget"
		title="SoundCloud player"
		allow="autoplay; encrypted-media"
		src={WIDGET_SRC}
		data-music-widget
	></iframe>
</div>

<style>
	.music-eq {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}

	.music-eq__toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		margin: 0;
		padding: 0;
		border: 0;
		border-radius: 0.25rem;
		background: transparent;
		color: var(--color-accent);
		cursor: pointer;
	}

	.music-eq__toggle:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
	}

	.music-eq__bars {
		display: block;
		width: 38px;
		height: 16px;
		overflow: visible;
		flex-shrink: 0;
	}

	.music-eq__bar {
		fill: currentColor;
		width: 2px;
		transform: none;
	}

	.music-eq:not(.is-playing) .music-eq__bar {
		animation: none;
	}

	.music-eq__widget {
		position: fixed;
		left: 0;
		bottom: 0;
		width: 1px;
		height: 1px;
		opacity: 0.001;
		pointer-events: none;
		border: 0;
		overflow: hidden;
		z-index: -1;
	}
</style>

<style is:global>
	@keyframes music-eq-bounce {
		0% {
			height: calc(var(--bar-from, 4) * 1px);
			y: calc((16 - var(--bar-from, 4)) / 2 * 1px);
		}
		100% {
			height: calc(var(--bar-to, 16) * 1px);
			y: calc((16 - var(--bar-to, 16)) / 2 * 1px);
		}
	}

	.music-eq-bar-animating {
		width: 2px;
		transform: none;
		animation: music-eq-bounce var(--bar-duration, 0.5s) ease-in-out infinite alternate;
	}

	@media (prefers-reduced-motion: reduce) {
		.music-eq-bar-animating {
			animation: none;
			height: calc(var(--bar-to, 12) * 1px);
			y: calc((16 - var(--bar-to, 12)) / 2 * 1px);
		}
	}
</style>

<script>
	type SoundCloudWidget = {
		bind: (event: string, listener: (...args: unknown[]) => void) => void;
		play: () => void;
		pause: () => void;
		toggle: () => void;
		seekTo: (ms: number) => void;
		isPaused: (callback: (paused: boolean) => void) => void;
	};

	type SoundCloudWidgetFactory = {
		Widget: {
			(iframe: HTMLIFrameElement): SoundCloudWidget;
			Events: {
				READY: string;
				PLAY: string;
				PAUSE: string;
				FINISH: string;
			};
		};
	};

	type WeddingMusicApi = {
		play: () => void;
		pause: () => void;
		toggle: () => void;
	};

	const root = document.querySelector<HTMLElement>('[data-music-player]');
	const toggle = root?.querySelector<HTMLButtonElement>('[data-music-toggle]');
	const iframe = root?.querySelector<HTMLIFrameElement>('[data-music-widget]');
	const bars = root ? Array.from(root.querySelectorAll<SVGRectElement>('[data-bar]')) : [];

	if (root && toggle && iframe) {
		let widget: SoundCloudWidget | null = null;
		let ready = false;
		let playWhenReady = false;
		let isPlaying = false;

		const setPlaying = (next: boolean) => {
			isPlaying = next;
			root.classList.toggle('is-playing', next);
			toggle.setAttribute('aria-pressed', next ? 'true' : 'false');
			toggle.setAttribute('aria-label', next ? 'Pausar música' : 'Reproducir música');

			bars.forEach((bar, index) => {
				if (next) {
					bar.style.animationDelay = `${index * 70}ms`;
					bar.style.height = '';
					bar.style.y = '';
					bar.classList.add('music-eq-bar-animating');
				} else {
					bar.classList.remove('music-eq-bar-animating');
					bar.style.animationDelay = '';
					bar.style.height = '';
					bar.style.y = '';
					bar.setAttribute('height', '2');
					bar.setAttribute('y', '7');
				}
			});
		};

		const playMusic = ({ fromStart = false }: { fromStart?: boolean } = {}) => {
			if (!widget || !ready) {
				playWhenReady = true;
				setPlaying(true);
				return;
			}

			if (fromStart) widget.seekTo(0);
			widget.play();
			setPlaying(true);
		};

		const pauseMusic = () => {
			playWhenReady = false;
			widget?.pause();
			setPlaying(false);
		};

		const toggleMusic = () => {
			if (!widget || !ready) {
				playMusic({ fromStart: true });
				return;
			}

			widget.isPaused((paused) => {
				if (paused) playMusic();
				else pauseMusic();
			});
		};

		const bindWidget = (SC: SoundCloudWidgetFactory) => {
			widget = SC.Widget(iframe);

			widget.bind(SC.Widget.Events.READY, () => {
				ready = true;
				if (playWhenReady) playMusic({ fromStart: true });
			});

			widget.bind(SC.Widget.Events.PLAY, () => setPlaying(true));
			widget.bind(SC.Widget.Events.PAUSE, () => setPlaying(false));
			widget.bind(SC.Widget.Events.FINISH, () => {
				// Loop from the beginning when the track ends.
				playMusic({ fromStart: true });
			});
		};

		const ensureApi = () => {
			const win = window as Window & { SC?: SoundCloudWidgetFactory };
			if (win.SC?.Widget) {
				bindWidget(win.SC);
				return;
			}

			const existing = document.querySelector<HTMLScriptElement>('script[data-soundcloud-api]');
			if (existing) {
				existing.addEventListener('load', () => {
					if (win.SC) bindWidget(win.SC);
				});
				return;
			}

			const script = document.createElement('script');
			script.src = 'https://w.soundcloud.com/player/api.js';
			script.async = true;
			script.dataset.soundcloudApi = '';
			script.addEventListener('load', () => {
				if (win.SC) bindWidget(win.SC);
			});
			document.body.appendChild(script);
		};

		toggle.addEventListener('click', () => {
			toggleMusic();
		});

		window.addEventListener('wedding:start-music', () => {
			playMusic({ fromStart: true });
		});

		(window as Window & { __weddingMusic?: WeddingMusicApi }).__weddingMusic = {
			play: () => playMusic({ fromStart: true }),
			pause: pauseMusic,
			toggle: toggleMusic,
		};

		ensureApi();
	}
</script>
