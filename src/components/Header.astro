---
import ConfirmButton from './ConfirmButton.astro';

const navLinks = [
	{ href: '#boquete', label: 'Boquete' },
	{ href: '#itinerary', label: 'Itinerary' },
	{ href: '#faq', label: 'FAQ' },
	{ href: '#contact', label: 'Contact' },
];
---

<div class="site-header-spacer" data-header-spacer hidden></div>
<header class="site-header" data-header>
	<div class="site-header__meta">
		<span>Panamonte, Boquete</span>
		<span class="site-header__meta-rule" aria-hidden="true"></span>
		<span>10 | 04 | 2027</span>
	</div>

	<div class="site-header__bar">
		<div class="site-header__brand">
			<a href="/" class="site-header__logo" aria-label="Andrea & Chris">
				<img src="/logo.svg" width="153" height="17" alt="Andrea & Chris" />
			</a>

			<div class="site-header__pill">
				<span>Panamonte, Boquete</span>
				<span class="site-header__pill-sep" aria-hidden="true">—</span>
				<span>10 | 04 | 2027</span>
			</div>
		</div>

		<nav class="site-header__nav" aria-label="Primary">
			{
				navLinks.map((link) => (
					<a href={link.href} class="site-header__link">
						{link.label}
					</a>
				))
			}
			<ConfirmButton variant="header" />
		</nav>

		<button
			type="button"
			class="site-header__menu"
			aria-label="Open menu"
			aria-expanded="false"
			aria-controls="mobile-menu"
			data-menu-toggle
		>
			<span class="site-header__menu-icon" aria-hidden="true">
				<span class="site-header__menu-line site-header__menu-line--top"></span>
				<span class="site-header__menu-line site-header__menu-line--bottom"></span>
			</span>
		</button>
	</div>

	<nav
		id="mobile-menu"
		class="site-header__drawer"
		aria-label="Mobile"
		aria-hidden="true"
		data-menu-drawer
	>
		<div class="site-header__drawer-links">
			{
				navLinks.map((link) => (
					<a href={link.href} class="site-header__drawer-link">
						{link.label}
					</a>
				))
			}
		</div>
		<ConfirmButton variant="header" class="site-header__drawer-cta" />
	</nav>
</header>

<style>
	.site-header-spacer[hidden] {
		display: none;
	}

	.site-header {
		position: relative;
		z-index: 20;
		background: var(--color-white);
	}

	.site-header.is-open {
		position: fixed;
		inset: 0;
		display: flex;
		flex-direction: column;
		background: var(--color-white);
	}

	.site-header__meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.55rem 1rem;
		background: var(--color-surface);
		color: var(--color-accent);
		font-size: 0.8125rem;
		font-weight: 500;
		letter-spacing: 0.02em;
	}

	.site-header__meta > span:not(.site-header__meta-rule) {
		flex-shrink: 0;
		white-space: nowrap;
	}

	.site-header__meta-rule {
		flex: 0 1 1.25rem;
		width: 1.25rem;
		min-width: 0.5rem;
		height: 1px;
		background: color-mix(in srgb, var(--color-accent) 28%, transparent);
	}

	.site-header__bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 0.95rem 1rem 1rem;
		background: var(--color-white);
	}

	.site-header__brand {
		display: flex;
		align-items: center;
		gap: 1rem;
		min-width: 0;
	}

	.site-header__logo {
		display: inline-flex;
		flex-shrink: 0;
	}

	.site-header__logo img {
		width: auto;
		height: 0.95rem;
	}

	.site-header__pill {
		display: none;
		align-items: center;
		gap: 0.55rem;
		padding: 0.55rem 1rem;
		background: var(--color-surface);
		font-size: 0.875rem;
		font-weight: 500;
		letter-spacing: 0.01em;
		white-space: nowrap;
	}

	.site-header__pill-sep {
		opacity: 0.55;
	}

	.site-header__nav {
		display: none;
		align-items: center;
		gap: 1.35rem;
	}

	.site-header__link {
		font-size: 0.9375rem;
		font-weight: 500;
		transition: opacity 0.2s ease;
	}

	.site-header__link:hover {
		opacity: 0.65;
	}

	.site-header__menu {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--color-accent);
	}

	.site-header__menu-icon {
		position: relative;
		display: block;
		width: 1.35rem;
		height: 0.7rem;
	}

	.site-header__menu-line {
		position: absolute;
		right: 0;
		display: block;
		height: 1.5px;
		background: currentColor;
		transform-origin: center;
		transition:
			transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
			width 0.35s cubic-bezier(0.22, 1, 0.36, 1),
			top 0.35s cubic-bezier(0.22, 1, 0.36, 1),
			right 0.35s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.site-header__menu-line--top {
		top: 0;
		width: 0.85rem;
	}

	.site-header__menu-line--bottom {
		top: calc(100% - 1.5px);
		width: 1.35rem;
	}

	.site-header.is-open .site-header__menu-line--top,
	.site-header.is-open .site-header__menu-line--bottom {
		top: calc(50% - 0.75px);
		right: 0;
		width: 1.35rem;
	}

	.site-header.is-open .site-header__menu-line--top {
		transform: rotate(45deg);
	}

	.site-header.is-open .site-header__menu-line--bottom {
		transform: rotate(-45deg);
	}

	.site-header__drawer {
		display: none;
		flex: 1;
		flex-direction: column;
		padding: 1.75rem 1.25rem 1.5rem;
		background: var(--color-white);
		overflow: auto;
	}

	.site-header.is-open .site-header__drawer {
		display: flex;
	}

	.site-header__drawer-links {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}

	.site-header__drawer-link {
		font-size: 1.75rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1.1;
	}

	.site-header__drawer :global(.site-header__drawer-cta) {
		width: 100%;
		margin-top: auto;
		padding-block: 1.05rem;
		justify-content: center;
	}

	@media (min-width: 900px) {
		.site-header.is-open {
			position: relative;
			inset: auto;
			display: block;
		}

		.site-header__meta,
		.site-header__menu,
		.site-header__drawer {
			display: none;
		}

		.site-header.is-open .site-header__drawer {
			display: none;
		}

		.site-header__bar {
			padding: 1.1rem 1.75rem;
		}

		.site-header__brand {
			gap: 1.25rem;
		}

		.site-header__logo img {
			height: 1.05rem;
		}

		.site-header__pill,
		.site-header__nav {
			display: flex;
		}
	}
</style>

<script>
	const header = document.querySelector<HTMLElement>('[data-header]');
	const spacer = document.querySelector<HTMLElement>('[data-header-spacer]');
	const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
	const drawer = document.querySelector<HTMLElement>('[data-menu-drawer]');

	if (header && toggle && drawer && spacer) {
		const setOpen = (open: boolean) => {
			if (open) {
				spacer.style.height = `${header.offsetHeight}px`;
				spacer.hidden = false;
			} else {
				spacer.hidden = true;
				spacer.style.height = '';
			}

			header.classList.toggle('is-open', open);
			document.body.classList.toggle('menu-open', open);
			drawer.setAttribute('aria-hidden', open ? 'false' : 'true');
			toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
			toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
		};

		toggle.addEventListener('click', () => {
			setOpen(!header.classList.contains('is-open'));
		});

		drawer.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setOpen(false));
		});

		window.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && header.classList.contains('is-open')) {
				setOpen(false);
			}
		});
	}
</script>
