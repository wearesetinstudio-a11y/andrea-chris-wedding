---
import ConfirmButton from './ConfirmButton.astro';

const navLinks = [
	{ href: '#boquete', label: 'Boquete' },
	{ href: '#itinerary', label: 'Itinerary' },
	{ href: '#faq', label: 'FAQ' },
	{ href: '#contact', label: 'Contact' },
];
---

<header class="site-header">
	<div class="site-header__meta">
		<span>Panamonte, Boquete</span>
		<span class="site-header__meta-rule" aria-hidden="true"></span>
		<span>10 | 04 | 2027</span>
	</div>

	<div class="site-header__bar">
		<a href="/" class="site-header__logo" aria-label="Andrea & Chris">
			<img src="/logo.svg" width="153" height="17" alt="Andrea & Chris" />
		</a>

		<div class="site-header__pill" aria-hidden="false">
			<span>Panamonte, Boquete</span>
			<span class="site-header__pill-sep" aria-hidden="true">—</span>
			<span>10 | 04 | 2027</span>
		</div>

		<nav class="site-header__nav" aria-label="Primary">
			{
				navLinks.map((link) => (
					<a href={link.href} class="site-header__link">
						{link.label}
					</a>
				))
			}
			<ConfirmButton variant="header" />
		</nav>

		<button
			type="button"
			class="site-header__menu"
			aria-label="Open menu"
			aria-expanded="false"
			data-menu-toggle
		>
			<span class="site-header__menu-line site-header__menu-line--short"></span>
			<span class="site-header__menu-line"></span>
		</button>
	</div>

	<nav class="site-header__drawer" aria-label="Mobile" data-menu-drawer hidden>
		{
			navLinks.map((link) => (
				<a href={link.href} class="site-header__drawer-link">
					{link.label}
				</a>
			))
		}
		<ConfirmButton variant="header" class="site-header__drawer-cta" />
	</nav>
</header>

<style>
	.site-header {
		position: relative;
		z-index: 20;
		background: var(--color-white);
	}

	.site-header__meta {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 0.75rem;
		padding: 0.55rem 1rem;
		background: var(--color-surface);
		color: var(--color-accent);
		font-size: 0.8125rem;
		font-weight: 500;
		letter-spacing: 0.02em;
	}

	.site-header__meta > span:first-child {
		justify-self: start;
	}

	.site-header__meta > span:last-child {
		justify-self: end;
		text-align: right;
	}

	.site-header__meta-rule {
		width: 2.75rem;
		height: 1px;
		background: color-mix(in srgb, var(--color-accent) 28%, transparent);
	}

	.site-header__bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 0.95rem 1rem 1rem;
	}

	.site-header__logo {
		display: inline-flex;
		flex-shrink: 0;
	}

	.site-header__logo img {
		width: auto;
		height: 0.95rem;
	}

	.site-header__pill {
		display: none;
		align-items: center;
		gap: 0.55rem;
		padding: 0.55rem 1rem;
		background: var(--color-surface);
		font-size: 0.875rem;
		font-weight: 500;
		letter-spacing: 0.01em;
		white-space: nowrap;
	}

	.site-header__pill-sep {
		opacity: 0.55;
	}

	.site-header__nav {
		display: none;
		align-items: center;
		gap: 1.35rem;
	}

	.site-header__link {
		font-size: 0.9375rem;
		font-weight: 500;
		transition: opacity 0.2s ease;
	}

	.site-header__link:hover {
		opacity: 0.65;
	}

	.site-header__menu {
		display: inline-flex;
		flex-direction: column;
		align-items: flex-end;
		justify-content: center;
		gap: 0.35rem;
		width: 2rem;
		height: 2rem;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--color-accent);
	}

	.site-header__menu-line {
		display: block;
		width: 1.35rem;
		height: 1.5px;
		background: currentColor;
	}

	.site-header__menu-line--short {
		width: 0.85rem;
	}

	.site-header__drawer {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 0.25rem 1rem 1.25rem;
		border-top: 1px solid color-mix(in srgb, var(--color-accent) 8%, transparent);
		background: var(--color-white);
	}

	.site-header__drawer[hidden] {
		display: none;
	}

	.site-header__drawer-link {
		font-size: 1.0625rem;
		font-weight: 500;
	}

	.site-header__drawer-cta {
		align-self: flex-start;
		margin-top: 0.25rem;
	}

	@media (min-width: 900px) {
		.site-header__meta,
		.site-header__menu,
		.site-header__drawer {
			display: none;
		}

		.site-header__bar {
			padding: 1.1rem 1.75rem;
		}

		.site-header__logo img {
			height: 1.05rem;
		}

		.site-header__pill,
		.site-header__nav {
			display: flex;
		}

		.site-header__bar {
			display: grid;
			grid-template-columns: 1fr auto 1fr;
			align-items: center;
		}

		.site-header__nav {
			justify-self: end;
		}
	}
</style>

<script>
	const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
	const drawer = document.querySelector<HTMLElement>('[data-menu-drawer]');

	if (toggle && drawer) {
		toggle.addEventListener('click', () => {
			const open = drawer.hasAttribute('hidden');
			if (open) {
				drawer.removeAttribute('hidden');
				toggle.setAttribute('aria-expanded', 'true');
				toggle.setAttribute('aria-label', 'Close menu');
			} else {
				drawer.setAttribute('hidden', '');
				toggle.setAttribute('aria-expanded', 'false');
				toggle.setAttribute('aria-label', 'Open menu');
			}
		});

		drawer.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => {
				drawer.setAttribute('hidden', '');
				toggle.setAttribute('aria-expanded', 'false');
				toggle.setAttribute('aria-label', 'Open menu');
			});
		});
	}
</script>