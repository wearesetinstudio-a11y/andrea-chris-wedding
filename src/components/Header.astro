---
import ConfirmButton from './ConfirmButton.astro';
import MusicPlayerBadge from './MusicPlayerBadge.astro';

const navLinks = [
	{ href: '#boquete', label: 'Nuestra Boda' },
	{ href: '#itinerary', label: 'Itinerario' },
	{ href: '#faq', label: 'Detalles' },
	{ href: '#contact', label: 'Contacto' },
];
---

<div class="site-header-spacer" data-header-spacer aria-hidden="true"></div>
<header class="site-header" data-header>
	<div class="site-header__bar">
		<a href="/" class="site-header__logo" aria-label="Andrea & Chris">
			<img src="/logo.svg" width="153" height="17" alt="Andrea & Chris" />
		</a>

		<nav class="site-header__nav" aria-label="Primary">
			{
				navLinks.map((link) => (
					<a href={link.href} class="site-header__link">
						{link.label}
					</a>
				))
			}
		</nav>

		<div class="site-header__actions">
			<div class="site-header__music">
				<MusicPlayerBadge />
			</div>
			<ConfirmButton variant="header" class="site-header__confirm" />
			<button
				type="button"
				class="site-header__menu"
				aria-label="Abrir menú"
				aria-expanded="false"
				aria-controls="mobile-menu"
				data-menu-toggle
			>
				<span class="site-header__menu-icon" aria-hidden="true">
					<span class="site-header__menu-line site-header__menu-line--top"></span>
					<span class="site-header__menu-line site-header__menu-line--bottom"></span>
				</span>
			</button>
		</div>
	</div>

	<nav
		id="mobile-menu"
		class="site-header__drawer"
		aria-label="Mobile"
		aria-hidden="true"
		data-menu-drawer
	>
		<div class="site-header__drawer-links">
			{
				navLinks.map((link) => (
					<a href={link.href} class="site-header__drawer-link">
						{link.label}
					</a>
				))
			}
		</div>
		<ConfirmButton variant="header" class="site-header__drawer-cta" />
	</nav>
</header>

<style>
	.site-header-spacer {
		height: var(--header-height);
		pointer-events: none;
	}

	.site-header {
		position: fixed;
		inset-inline: 0;
		top: 0;
		z-index: 20;
		background: var(--color-white);
		transform: translateY(0);
		transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
		will-change: transform;
	}

	.site-header.is-hidden {
		transform: translateY(-100%);
		pointer-events: none;
	}

	.site-header.is-open {
		inset: 0;
		display: flex;
		flex-direction: column;
		transform: none;
		background: var(--color-white);
	}

	.site-header__bar {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 0.75rem;
		min-height: var(--header-height);
		padding: 0.85rem var(--page-inset);
		background: var(--color-white);
	}

	.site-header__logo {
		display: inline-flex;
		flex-shrink: 0;
		justify-self: start;
	}

	.site-header__logo img {
		width: auto;
		height: 0.95rem;
	}

	.site-header__nav {
		display: none;
		align-items: center;
		gap: 1.5rem;
	}

	.site-header__link {
		font-size: 0.9375rem;
		font-weight: 500;
		transition: opacity 0.2s ease;
	}

	.site-header__link:hover {
		opacity: 0.65;
	}

	.site-header__actions {
		display: contents;
	}

	.site-header__music {
		display: inline-flex;
		align-items: center;
		justify-self: center;
		grid-column: 2;
	}

	.site-header__actions :global(.site-header__confirm) {
		display: none;
	}

	.site-header__menu {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		justify-self: end;
		grid-column: 3;
		width: 2rem;
		height: 2rem;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--color-accent);
	}

	.site-header__menu-icon {
		position: relative;
		display: block;
		width: 1.35rem;
		height: 0.7rem;
	}

	.site-header__menu-line {
		position: absolute;
		right: 0;
		display: block;
		height: 1.5px;
		background: currentColor;
		transform-origin: center;
		transition:
			transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
			width 0.35s cubic-bezier(0.22, 1, 0.36, 1),
			top 0.35s cubic-bezier(0.22, 1, 0.36, 1),
			right 0.35s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.site-header__menu-line--top {
		top: 0;
		width: 0.85rem;
	}

	.site-header__menu-line--bottom {
		top: calc(100% - 1.5px);
		width: 1.35rem;
	}

	.site-header.is-open .site-header__menu-line--top,
	.site-header.is-open .site-header__menu-line--bottom {
		top: calc(50% - 0.75px);
		right: 0;
		width: 1.35rem;
	}

	.site-header.is-open .site-header__menu-line--top {
		transform: rotate(45deg);
	}

	.site-header.is-open .site-header__menu-line--bottom {
		transform: rotate(-45deg);
	}

	.site-header__drawer {
		display: none;
		flex: 1;
		flex-direction: column;
		padding: 1.75rem var(--page-inset) 1.5rem;
		background: var(--color-white);
		overflow: auto;
	}

	.site-header.is-open .site-header__drawer {
		display: flex;
	}

	.site-header__drawer-links {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}

	.site-header__drawer-link {
		font-size: 1.75rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1.1;
	}

	.site-header__drawer :global(.site-header__drawer-cta) {
		width: 100%;
		margin-top: auto;
		padding-block: 1.05rem;
		justify-content: center;
	}

	@media (min-width: 900px) {
		.site-header.is-open {
			bottom: auto;
			display: block;
		}

		.site-header__bar {
			gap: 1.5rem;
			padding-block: 1rem;
		}

		.site-header__logo img {
			height: 1.05rem;
		}

		.site-header__nav {
			display: flex;
			justify-self: center;
			grid-column: 2;
		}

		.site-header__actions {
			display: flex;
			align-items: center;
			justify-self: end;
			grid-column: 3;
			gap: 1.1rem;
		}

		.site-header__music {
			justify-self: auto;
			grid-column: auto;
		}

		.site-header__actions :global(.site-header__confirm) {
			display: inline-flex;
		}

		.site-header__menu,
		.site-header__drawer,
		.site-header.is-open .site-header__drawer {
			display: none;
		}
	}
</style>

<script>
	const header = document.querySelector<HTMLElement>('[data-header]');
	const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
	const drawer = document.querySelector<HTMLElement>('[data-menu-drawer]');

	if (header && toggle && drawer) {
		const setOpen = (open: boolean) => {
			if (open) header.classList.remove('is-hidden');

			header.classList.toggle('is-open', open);
			document.body.classList.toggle('menu-open', open);
			drawer.setAttribute('aria-hidden', open ? 'false' : 'true');
			toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
			toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
		};

		toggle.addEventListener('click', () => {
			setOpen(!header.classList.contains('is-open'));
		});

		drawer.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setOpen(false));
		});

		window.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && header.classList.contains('is-open')) {
				setOpen(false);
			}
		});

		let lastY = window.scrollY;
		let ticking = false;
		const delta = 6;
		const topShow = 8;

		const onScroll = () => {
			if (ticking) return;
			ticking = true;

			requestAnimationFrame(() => {
				ticking = false;
				const y = window.scrollY;

				if (header.classList.contains('is-open')) {
					lastY = y;
					return;
				}

				if (y <= topShow) {
					header.classList.remove('is-hidden');
				} else if (y > lastY + delta) {
					header.classList.add('is-hidden');
				} else if (y < lastY - delta) {
					header.classList.remove('is-hidden');
				}

				lastY = y;
			});
		};

		window.addEventListener('scroll', onScroll, { passive: true });
	}
</script>
