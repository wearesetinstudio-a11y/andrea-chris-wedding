---
/**
 * “Descubre Boquete!” — horizontal polaroid recommendations carousel.
 * Desktop: title | subtitle | arrow controls. Mobile: centered copy, touch scroll.
 */
const rotations = [
	'-1.5deg',
	'2deg',
	'-1deg',
	'1.5deg',
	'-2deg',
	'1deg',
	'-0.75deg',
	'1.75deg',
	'-1.25deg',
	'0.85deg',
] as const;

const recommendations = [
	{
		title: 'Volcán Barú',
		image: '/images/baru.webp',
		mapUrl:
			'https://www.google.com/maps/place/Volc%C3%A1n+Bar%C3%BA/@8.8088319,-82.5526388,15z/data=!3m1!4b1!4m6!3m5!1s0x8fa5ea6050b7e431:0xaa272f8ce9430b06!8m2!3d8.808811!4d-82.542339!16zL20vMDV5bWZq',
	},
	{
		title: 'Paseo del Río',
		image: '/images/paseo-del-rio.webp',
		mapUrl:
			'https://www.google.com/maps/place/Paseo+del+R%C3%ADo/@8.7836267,-82.4318539,17z/data=!3m1!4b1!4m6!3m5!1s0x8fa5ed001a478695:0x6c389e45a7abe254!8m2!3d8.7836214!4d-82.429279!16s%2Fg%2F11vq2xdq3z',
	},
	{
		title: 'Cascada El Tatica',
		image: '/images/el-tatica.webp',
		mapUrl:
			'https://www.google.com/maps/place/Cascada+El+Tatica/@8.840474,-82.4875412,17z/data=!3m1!4b1!4m6!3m5!1s0x8fa5eb91f2bcdf31:0xd483187ab375edde!8m2!3d8.8404687!4d-82.4849663!16s%2Fg%2F11s9k8p4_7',
	},
	{
		title: 'Ecoparque Cerro la Cruz',
		image: '/images/ecoparque.webp',
		mapUrl:
			'https://www.google.com/maps/place/Ecoparque+Cerro+la+Cruz/@8.7848189,-82.4396645,17z/data=!3m1!4b1!4m6!3m5!1s0x8fa5ed3bd246340f:0x2647b930dc7a53b4!8m2!3d8.7848136!4d-82.4370896!16s%2Fg%2F11lrhfr5l2',
	},
	{
		title: 'Los Ladrillos',
		image: '/images/ladrillos.webp',
		mapUrl:
			'https://www.google.com/maps/place/Parque+ecol%C3%B3gico+Los+ladrillos/@8.8000862,-82.453915,17z/data=!3m1!4b1!4m6!3m5!1s0x8fa5eda82f6b2311:0x55bdb09e6fcc612c!8m2!3d8.8000809!4d-82.4513401!16s%2Fg%2F11j237tt0s',
	},
	{
		title: 'Sendero The Pipeline',
		image: '/images/the-pipeline.webp',
		mapUrl:
			'https://www.google.com/maps/place/Pipeline+Trail+(Waterfall)/@8.8300951,-82.4828879,17z/data=!3m1!4b1!4m6!3m5!1s0x8fa5ebf47c77ef1d:0x9a976151b58581ae!8m2!3d8.8300898!4d-82.480313!16s%2Fg%2F11c2j30rdg',
	},
	{
		title: 'Finca Lérida Coffee Shop',
		image: '/images/finca-lerida.webp',
		mapUrl:
			'https://www.google.com/maps/place/Finca+L%C3%A9rida+Coffee+Shop/@8.8130148,-82.4855245,17z/data=!3m1!4b1!4m9!3m8!1s0x8fa5eb8800239553:0xa14d1cbe133e7964!5m2!4m1!1i2!8m2!3d8.8130095!4d-82.4829496!16s%2Fg%2F11h37lj1dp',
	},
	{
		title: 'San Ramón Waterfall',
		image: '/images/san-ramon.webp',
		mapUrl:
			'https://www.google.com/maps/place/San+Ram%C3%B3n+Waterfall/@8.8175653,-82.4680349,17z/data=!3m1!4b1!4m6!3m5!1s0x8fa5ec703eaa09d7:0x277a5c1573a37c97!8m2!3d8.81756!4d-82.46546!16s%2Fg%2F11bx1yqnz5',
	},
	{
		title: 'Piedra Pintada',
		image: '/images/piedra-pintada.webp',
		mapUrl:
			'https://www.google.com/maps/place/Piedras+Pintadas+de+Caldera+(petroglifos+de+Caldera)/@8.666882,-82.4167227,13.25z/data=!4m6!3m5!1s0x8fa58e13458188d7:0x76c9c98999bae773!8m2!3d8.6593855!4d-82.3699076!16s%2Fg%2F11ckvkrkzg',
	},
	{
		title: 'Altieri Coffee',
		image: '/images/altieri-coffee.webp',
		mapUrl:
			'https://www.google.com/maps/place/Altieri+Coffee+Boquete/data=!4m2!3m1!1s0x8fa5ed9ad33a0685:0x668477a4390b1879',
	},
].map((item, index) => ({
	...item,
	rotation: rotations[index % rotations.length],
}));
---

<section
	id="boquete"
	class="recommendations"
	aria-labelledby="recommendations-title"
	data-recommendations
>
	<div class="recommendations__inner">
		<header
			class="recommendations__header flex flex-col items-center gap-4 text-center lg:grid lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1.35fr)_auto] lg:items-start lg:gap-8 lg:text-left"
		>
			<h2
				id="recommendations-title"
				class="recommendations__title m-0 whitespace-nowrap font-serif font-normal text-[clamp(2rem,5vw,3.25rem)] leading-[1.05] tracking-[-0.01em] text-[#f7f2ea]"
				data-reveal
			>
				Descubre Boquete!
			</h2>

			<p
				class="recommendations__subtitle m-0 max-w-[22rem] font-sans text-[0.9375rem] leading-relaxed text-[#f7f2ea]/90 lg:max-w-[21rem] lg:justify-self-center lg:pt-1"
				data-reveal
				data-reveal-group="recommendations"
				style="--reveal-delay: 80ms"
			>
				¿Llegan unos días antes o se quedan un poquito más? Les dejamos algunos de nuestros
				rinconcitos favoritos para que se enamoren de Boquete.
			</p>

			<div
				class="recommendations__nav hidden items-center gap-3 lg:flex lg:justify-self-end lg:pt-1"
				role="group"
				aria-label="Navegar recomendaciones"
			>
				<button
					type="button"
					class="recommendations__arrow"
					aria-label="Anterior"
					data-rec-prev
				>
					<img src="/Arrow.svg" alt="" width="24" height="24" aria-hidden="true" />
				</button>
				<button
					type="button"
					class="recommendations__arrow recommendations__arrow--next"
					aria-label="Siguiente"
					data-rec-next
				>
					<img src="/Arrow.svg" alt="" width="24" height="24" aria-hidden="true" />
				</button>
			</div>
		</header>

		<div
			class="recommendations__track"
			data-rec-track
			tabindex="0"
			role="region"
			aria-label="Lugares recomendados en Boquete"
		>
			<ul class="recommendations__list" role="list">
				{
					recommendations.map((item) => (
						<li class="recommendations__item" style={`--rot: ${item.rotation}`}>
							<a
								class="recommendations__polaroid"
								href={item.mapUrl}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={`${item.title} — ver en el mapa`}
								data-tilt
							>
								<div class="recommendations__photo">
									<img
										src={item.image}
										alt=""
										width="640"
										height="800"
										loading="lazy"
										draggable="false"
									/>
								</div>
								<p class="recommendations__caption font-handlee">{item.title}</p>
								<span class="recommendations__map text-xs text-stone-500">
									Ver en el mapa →
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>

		<div
			class="recommendations__dots"
			role="tablist"
			aria-label="Posición del carrusel"
			data-rec-dots
		>
			{
				recommendations.map((item, index) => (
					<button
						type="button"
						class:list={['recommendations__dot', index === 0 && 'is-active']}
						role="tab"
						aria-label={`Ir a ${item.title}`}
						aria-selected={index === 0 ? 'true' : 'false'}
						data-rec-dot={index}
					/>
				))
			}
		</div>
	</div>
</section>

<style>
	.recommendations {
		position: relative;
		overflow-x: clip;
		overflow-y: visible;
		padding: 5.5rem 0 0;
		background: var(--color-section);
	}

	.recommendations__inner {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
		width: 100%;
		max-width: 90rem;
		margin-inline: auto;
		padding-inline: var(--page-inset);
	}

	.recommendations__subtitle {
		text-align: justify;
		text-justify: inter-word;
	}

	.recommendations__arrow {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		margin: 0;
		padding: 0;
		border: 0;
		border-radius: 0;
		background: rgb(255 255 255 / 8%);
		transition: background 0.2s ease;
	}

	.recommendations__arrow img {
		display: block;
		width: 1.25rem;
		height: 1.25rem;
		pointer-events: none;
		user-select: none;
	}

	.recommendations__arrow--next img {
		transform: scaleX(-1);
	}

	.recommendations__arrow:hover:not(:disabled) {
		background: rgb(255 255 255 / 20%);
	}

	.recommendations__arrow:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 3px;
	}

	.recommendations__arrow:disabled {
		opacity: 0.4;
		cursor: default;
	}

	.recommendations__track {
		margin-inline: calc(var(--page-inset) * -1);
		padding-inline: var(--page-inset);
		/*
		 * Horizontal scroll forces overflow-y clipping — keep generous
		 * block padding so gyro/mouse tilt shadows fade instead of cutting.
		 */
		padding-top: 2.5rem;
		padding-bottom: 4.75rem;
		overflow-x: auto;
		overflow-y: hidden;
		scroll-snap-type: x mandatory;
		scroll-padding-inline: var(--page-inset);
		-webkit-overflow-scrolling: touch;
		scrollbar-width: none;
		-ms-overflow-style: none;
		outline: none;
		border: 0;
		background: transparent;
		cursor: grab;
	}

	.recommendations__track.is-dragging {
		cursor: grabbing;
		scroll-snap-type: none;
		user-select: none;
	}

	.recommendations__track.is-dragging a {
		pointer-events: none;
	}

	.recommendations__track::-webkit-scrollbar {
		display: none;
		width: 0;
		height: 0;
		background: transparent;
	}

	.recommendations__list {
		display: flex;
		align-items: flex-start;
		gap: clamp(1.1rem, 2.5vw, 1.75rem);
		margin: 0;
		padding: 1rem 0 0.5rem;
		list-style: none;
		width: max-content;
		min-width: 100%;
	}

	.recommendations__item {
		flex: 0 0 auto;
		scroll-snap-align: center;
		width: min(72vw, 16.75rem);
	}

	.recommendations__polaroid {
		--tilt-x: 0deg;
		--tilt-y: 0deg;
		--shadow-x: 0px;
		--shadow-y: 14px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.55rem;
		padding: 0.75rem 0.75rem 1.15rem;
		background: var(--color-white);
		color: inherit;
		text-decoration: none;
		box-shadow:
			0 1px 2px rgb(0 0 0 / 6%),
			var(--shadow-x) var(--shadow-y) 22px rgb(0 0 0 / 16%);
		transform: perspective(1000px) rotateX(var(--tilt-x)) rotateY(var(--tilt-y))
			rotate(var(--rot, 0deg));
		transform-style: preserve-3d;
		will-change: transform, box-shadow;
		cursor: pointer;
	}

	.recommendations__polaroid:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 4px;
	}

	.recommendations__photo {
		position: relative;
		width: 100%;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		background: color-mix(in srgb, var(--color-muted) 35%, var(--color-surface));
		transform-style: preserve-3d;
	}

	.recommendations__photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		user-select: none;
		/* Softer nested parallax — inherits --tilt-* from the polaroid */
		transform: perspective(800px) rotateX(calc(var(--tilt-x, 0deg) * 0.4))
			rotateY(calc(var(--tilt-y, 0deg) * 0.4)) scale(1.06);
		will-change: transform;
	}

	.recommendations__caption {
		margin: 0.15rem 0 0;
		text-align: center;
		font-size: clamp(1.05rem, 2.4vw, 1.25rem);
		line-height: 1.15;
		color: color-mix(in srgb, var(--color-accent) 82%, #6b5a4a);
	}

	.recommendations__map {
		display: inline-flex;
		align-items: center;
		margin: 0;
		font-family: var(--font-sans);
		font-weight: 400;
		line-height: 1.2;
		letter-spacing: 0.01em;
		transition: color 0.2s ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.recommendations__polaroid:hover .recommendations__map {
			color: var(--color-accent);
		}
	}

	.recommendations__dots {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		/* Sit under cards without eating the shadow breathing room above */
		margin-top: -2.25rem;
	}

	.recommendations__dot {
		box-sizing: border-box;
		display: block;
		flex: 0 0 auto;
		width: 4px;
		height: 4px;
		min-width: 4px;
		min-height: 4px;
		margin: 0;
		padding: 0;
		border: 0;
		border-radius: 0;
		aspect-ratio: 1;
		appearance: none;
		font-size: 0;
		line-height: 0;
		background: rgb(255 255 255 / 10%);
		cursor: pointer;
		transition: background 0.2s ease;
	}

	.recommendations__dot.is-active {
		background: rgb(255 255 255 / 100%);
	}

	.recommendations__dot:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 3px;
	}

	@media (min-width: 1024px) {
		.recommendations {
			padding: 7rem 0 0;
		}

		.recommendations__inner {
			gap: 4.25rem;
		}

		.recommendations__dots {
			display: none;
		}

		.recommendations__item {
			scroll-snap-align: start;
			width: min(20vw, 17.5rem);
		}

		.recommendations__polaroid {
			padding: 0.9rem 0.9rem 1.35rem;
			gap: 0.65rem;
			box-shadow:
				0 1px 2px rgb(0 0 0 / 8%),
				var(--shadow-x) var(--shadow-y) 28px rgb(0 0 0 / 18%);
		}
	}
</style>

<script>
	function initRecommendations(root: HTMLElement) {
		const track = root.querySelector<HTMLElement>('[data-rec-track]');
		const prev = root.querySelector<HTMLButtonElement>('[data-rec-prev]');
		const next = root.querySelector<HTMLButtonElement>('[data-rec-next]');
		const items = Array.from(root.querySelectorAll<HTMLElement>('.recommendations__item'));
		const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-rec-dot]'));

		if (!track || !prev || !next || items.length === 0) return;

		const scrollAmount = () => {
			const first = items[0];
			const styles = getComputedStyle(track.querySelector('.recommendations__list')!);
			const gap = Number.parseFloat(styles.columnGap || styles.gap || '24') || 24;
			return first.getBoundingClientRect().width + gap;
		};

		const activeIndex = () => {
			const amount = scrollAmount();
			if (amount <= 0) return 0;
			const maxScroll = track.scrollWidth - track.clientWidth;
			if (maxScroll <= 0) return 0;
			if (track.scrollLeft >= maxScroll - 4) return items.length - 1;
			return Math.min(items.length - 1, Math.max(0, Math.round(track.scrollLeft / amount)));
		};

		const updateDots = () => {
			const index = activeIndex();
			dots.forEach((dot, i) => {
				const on = i === index;
				dot.classList.toggle('is-active', on);
				dot.setAttribute('aria-selected', on ? 'true' : 'false');
			});
		};

		const updateButtons = () => {
			const maxScroll = track.scrollWidth - track.clientWidth;
			const atStart = track.scrollLeft <= 4;
			const atEnd = track.scrollLeft >= maxScroll - 4;
			prev.disabled = atStart;
			next.disabled = atEnd || maxScroll <= 0;
			updateDots();
		};

		const scrollByDir = (dir: -1 | 1) => {
			track.scrollBy({ left: dir * scrollAmount(), behavior: 'smooth' });
		};

		const scrollToIndex = (index: number) => {
			track.scrollTo({ left: index * scrollAmount(), behavior: 'smooth' });
		};

		prev.addEventListener('click', () => scrollByDir(-1));
		next.addEventListener('click', () => scrollByDir(1));
		dots.forEach((dot) => {
			dot.addEventListener('click', () => {
				const index = Number(dot.dataset.recDot);
				if (Number.isFinite(index)) scrollToIndex(index);
			});
		});
		track.addEventListener('scroll', updateButtons, { passive: true });
		window.addEventListener('resize', updateButtons, { passive: true });

		/**
		 * Mouse drag-to-scroll on desktop; touch keeps native pan.
		 * Capture only after a real drag so simple clicks still open map links.
		 */
		let dragPointerId: number | null = null;
		let dragStartX = 0;
		let dragStartScroll = 0;
		let dragMoved = false;
		const DRAG_THRESHOLD = 6;

		const endDrag = (event: PointerEvent) => {
			if (dragPointerId !== event.pointerId) return;
			const wasDragging = dragMoved;
			dragPointerId = null;
			track.classList.remove('is-dragging');
			try {
				track.releasePointerCapture(event.pointerId);
			} catch {
				/* already released */
			}
			/* Keep dragMoved true until click so we can suppress the post-drag click */
			if (!wasDragging) dragMoved = false;
		};

		track.addEventListener('pointerdown', (event) => {
			if (event.pointerType !== 'mouse' || event.button !== 0) return;
			dragPointerId = event.pointerId;
			dragStartX = event.clientX;
			dragStartScroll = track.scrollLeft;
			dragMoved = false;
		});

		track.addEventListener('pointermove', (event) => {
			if (dragPointerId !== event.pointerId) return;
			const delta = event.clientX - dragStartX;
			if (!dragMoved) {
				if (Math.abs(delta) < DRAG_THRESHOLD) return;
				dragMoved = true;
				track.classList.add('is-dragging');
				track.setPointerCapture(event.pointerId);
			}
			track.scrollLeft = dragStartScroll - delta;
		});

		track.addEventListener('pointerup', endDrag);
		track.addEventListener('pointercancel', endDrag);
		track.addEventListener('lostpointercapture', () => {
			dragPointerId = null;
			track.classList.remove('is-dragging');
		});

		track.addEventListener(
			'click',
			(event) => {
				if (!dragMoved) return;
				event.preventDefault();
				event.stopPropagation();
				dragMoved = false;
			},
			true,
		);

		updateButtons();
	}

	document
		.querySelectorAll<HTMLElement>('[data-recommendations]')
		.forEach(initRecommendations);
</script>
