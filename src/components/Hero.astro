---
import ConfirmButton from './ConfirmButton.astro';
import MusicPlayerBadge from './MusicPlayerBadge.astro';
---

<section class="hero" data-hero>
	<div class="hero__frame">
		<div class="hero__media" data-hero-media>
			<div class="hero__parallax" data-hero-parallax>
				<img
					class="hero__image"
					src="/bg_image.webp"
					alt="Andrea and Chris embracing outdoors"
					width="1600"
					height="2000"
					fetchpriority="high"
				/>
			</div>
			<div class="hero__veil" aria-hidden="true"></div>
		</div>

		<div class="hero__content">
			<div class="hero__music hero__enter" style="--enter-delay: 160ms">
				<MusicPlayerBadge />
			</div>

			<p class="hero__eyebrow hero__eyebrow--mobile hero__enter" style="--enter-delay: 240ms">
				Invitándote a ser parte de<br />nuestra historia de amor
			</p>

			<div class="hero__stage">
				<div class="hero__intro">
					<p class="hero__eyebrow hero__eyebrow--desktop hero__enter" style="--enter-delay: 120ms">
						Invitándote a ser parte de<br />nuestra historia de amor
					</p>
					<h1 class="hero__title" aria-label="Andrea & Chris">
						<span
							class="hero__name hero__name--andrea hero__enter"
							style="--enter-delay: 280ms"
							aria-hidden="true">Andrea</span
						>
						<span
							class="hero__name-row hero__enter"
							style="--enter-delay: 420ms"
							aria-hidden="true"
						>
							<span class="hero__amp">&</span>
							<span class="hero__name hero__name--chris">Chris</span>
						</span>
					</h1>
				</div>

				<div class="hero__cta-block hero__enter" style="--enter-delay: 580ms">
					<p class="hero__note">
						Avísanos si puedes acompañarnos<br />hasta finales de enero.
					</p>
					<ConfirmButton variant="hero" />
				</div>
			</div>

			<p class="hero__scroll hero__enter" style="--enter-delay: 720ms">(Desplaza hacia abajo ↓)</p>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		background: var(--color-white);
		padding: 0 0.75rem 0.75rem;
	}

	.hero__frame {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		/* Fill remaining viewport below header + bottom margin */
		height: calc(100svh - 6.75rem);
		min-height: 28rem;
		background: var(--color-accent);
	}

	.hero__media {
		position: absolute;
		inset: 0;
		overflow: hidden;
		z-index: 0;
	}

	.hero__parallax {
		position: absolute;
		left: 50%;
		top: -12%;
		width: 120%;
		height: 124%;
		transform: translate3d(-50%, 0, 0);
		will-change: transform;
	}

	.hero__image {
		width: 100%;
		height: 100%;
		max-width: none;
		object-fit: cover;
		object-position: center 28%;
		transform: scale(1.1);
		transform-origin: center center;
		transition: transform 2.2s cubic-bezier(0.22, 1, 0.36, 1);
		will-change: transform;
	}

	.hero.is-entered .hero__image {
		transform: scale(1);
	}

	.hero__veil {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(
				180deg,
				rgb(0 0 0 / 0.18) 0%,
				rgb(0 0 0 / 0.08) 28%,
				rgb(0 0 0 / 0.22) 62%,
				rgb(0 0 0 / 0.42) 100%
			);
		pointer-events: none;
	}

	.hero__music {
		position: relative;
		z-index: 2;
		width: max-content;
		max-width: 100%;
		margin: 0 0 1.15rem;
	}

	.hero__content {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		height: 100%;
		padding: 1.15rem 1.25rem 60px;
		color: var(--color-white);
		text-align: center;
	}

	.hero__eyebrow {
		margin: 0;
		font-size: 0.9375rem;
		font-weight: 400;
		line-height: 1.45;
		letter-spacing: 0.01em;
	}

	.hero__eyebrow--desktop {
		display: none;
	}

	.hero__stage {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.35rem;
		width: 100%;
		margin-top: auto;
	}

	.hero__intro {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.85rem;
	}

	.hero__title {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.12em;
		margin: 0;
		font-family: var(--font-serif);
		font-size: clamp(3.25rem, 13vw, 4.25rem);
		font-weight: 400;
		line-height: 0.92;
		letter-spacing: -0.02em;
	}

	.hero__name--andrea {
		display: block;
	}

	.hero__name-row {
		display: flex;
		align-items: baseline;
		gap: 0.28em;
	}

	.hero__amp {
		font-size: 0.58em;
		line-height: 1;
		transform: translateY(-0.06em);
	}

	.hero__cta-block {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 1rem;
		width: fit-content;
		max-width: 100%;
	}

	.hero__note {
		margin: 0;
		font-size: 0.9375rem;
		line-height: 1.45;
	}

	.hero__scroll {
		display: none;
		margin: 0;
		font-size: 0.9375rem;
		letter-spacing: 0.01em;
		opacity: 0.92;
		white-space: nowrap;
	}

	.hero__enter {
		opacity: 0;
		filter: blur(14px);
		transform: translate3d(0, 0.65rem, 0);
		transition:
			opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1) var(--enter-delay, 0ms),
			filter 0.9s cubic-bezier(0.22, 1, 0.36, 1) var(--enter-delay, 0ms),
			transform 0.9s cubic-bezier(0.22, 1, 0.36, 1) var(--enter-delay, 0ms);
		will-change: opacity, filter, transform;
	}

	.hero.is-entered .hero__enter {
		opacity: 1;
		filter: blur(0);
		transform: translate3d(0, 0, 0);
	}

	/* Keep centered — enter only blurs in place (no slide) */
	.hero__scroll.hero__enter {
		transform: translate3d(-50%, 0, 0);
	}

	.hero.is-entered .hero__scroll.hero__enter {
		opacity: 0.92;
		filter: blur(0);
		transform: translate3d(-50%, 0, 0);
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__enter {
			opacity: 1;
			filter: none;
			transform: none;
			transition: none;
		}

		.hero__image {
			transform: scale(1);
			transition: none;
		}
	}

	@media (min-width: 900px) {
		.hero {
			padding: 0 1.5rem 1.5rem;
		}

		.hero__frame {
			height: auto;
			min-height: calc(100svh - 5.25rem);
		}

		.hero__parallax {
			top: -18%;
			width: 112%;
			height: 136%;
		}

		.hero__image {
			object-position: center 32%;
		}

		.hero__music {
			position: absolute;
			top: 1.5rem;
			right: 2.75rem;
			left: auto;
			margin: 0;
		}

		.hero__content {
			display: flex;
			align-items: stretch;
			justify-content: flex-end;
			min-height: inherit;
			height: auto;
			padding: 2.5rem 2.75rem 1.5rem;
			text-align: left;
		}

		.hero__eyebrow--mobile {
			display: none;
		}

		.hero__eyebrow--desktop {
			display: block;
		}

		.hero__stage {
			flex-direction: row;
			align-items: flex-end;
			justify-content: space-between;
			gap: 2rem;
			width: 100%;
			margin-top: 0;
			padding-bottom: 2.35rem;
		}

		.hero__scroll {
			display: block;
			position: absolute;
			left: 50%;
			bottom: 1.35rem;
		}

		.hero__intro {
			align-items: flex-start;
			gap: 0.95rem;
		}

		.hero__title {
			align-items: flex-start;
			gap: 0.16em;
			font-size: clamp(5.5rem, 9vw, 8.25rem);
		}

		.hero__amp {
			font-size: 0.55em;
		}

		.hero__cta-block {
			align-items: stretch;
			text-align: right;
		}
	}
</style>

<script>
	const hero = document.querySelector<HTMLElement>('[data-hero]');
	const parallax = document.querySelector<HTMLElement>('[data-hero-parallax]');

	if (hero) {
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

		const playEnter = () => {
			hero.classList.add('is-entered');
		};

		if (reduceMotion.matches) {
			playEnter();
		} else {
			requestAnimationFrame(() => {
				requestAnimationFrame(playEnter);
			});
		}

		if (parallax) {
			const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
			const maxCursorShift = 20;
			const ease = 0.08;
			let targetX = 0;
			let targetY = 0;
			let currentX = 0;
			let currentY = 0;
			let rafId = 0;
			let running = false;

			const applyTransform = () => {
				if (reduceMotion.matches) {
					parallax.style.transform = 'translate3d(-50%, 0, 0)';
					return;
				}

				const rect = hero.getBoundingClientRect();
				const progress = Math.min(Math.max(-rect.top / Math.max(rect.height, 1), 0), 1);
				const scrollOffset = progress * rect.height * 0.35;

				const shiftX = finePointer.matches ? -currentX * maxCursorShift : 0;
				const shiftY = finePointer.matches ? -currentY * maxCursorShift : 0;

				parallax.style.transform = `translate3d(calc(-50% + ${shiftX}px), ${scrollOffset + shiftY}px, 0)`;
			};

			const tick = () => {
				currentX += (targetX - currentX) * ease;
				currentY += (targetY - currentY) * ease;

				applyTransform();

				const settled =
					Math.abs(targetX - currentX) < 0.001 && Math.abs(targetY - currentY) < 0.001;

				if (settled) {
					currentX = targetX;
					currentY = targetY;
					applyTransform();
					running = false;
					rafId = 0;
					return;
				}

				rafId = requestAnimationFrame(tick);
			};

			const startLoop = () => {
				if (!running) {
					running = true;
					rafId = requestAnimationFrame(tick);
				}
			};

			const onPointerMove = (event: PointerEvent) => {
				const rect = hero.getBoundingClientRect();
				const halfW = rect.width / 2 || 1;
				const halfH = rect.height / 2 || 1;
				targetX = Math.max(-1, Math.min(1, (event.clientX - rect.left - halfW) / halfW));
				targetY = Math.max(-1, Math.min(1, (event.clientY - rect.top - halfH) / halfH));
				startLoop();
			};

			const onPointerLeave = () => {
				targetX = 0;
				targetY = 0;
				startLoop();
			};

			const onScrollOrResize = () => {
				applyTransform();
			};

			applyTransform();
			window.addEventListener('scroll', onScrollOrResize, { passive: true });
			window.addEventListener('resize', onScrollOrResize);
			hero.addEventListener('pointermove', onPointerMove);
			hero.addEventListener('pointerleave', onPointerLeave);
			reduceMotion.addEventListener('change', () => {
				if (rafId) cancelAnimationFrame(rafId);
				running = false;
				currentX = targetX;
				currentY = targetY;
				applyTransform();
			});
			finePointer.addEventListener('change', applyTransform);
		}
	}
</script>