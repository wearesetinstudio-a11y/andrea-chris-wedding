---
/**
 * Scroll-driven “Nuestra historia”: sticky three-column layout on desktop
 * (title | polaroid stack | narrative) with cards stacking from below;
 * on mobile, cards slide in from the right within one viewport.
 */
const placeholderSrc = '/bg_image.webp';

const milestones = [
	{
		label: '2019',
		rotation: '-2deg',
		image: '/images/2019.webp',
		text: 'En enero de 2019, un viaje para conocer al papa Francisco terminó cambiando nuestras vidas para siempre. Sin saberlo, nuestros caminos ya estaban destinados a encontrarse. Lo que comenzó como una coincidencia se convirtió en una historia de amor que desafiaría más de 10,000 kilómetros de distancia, siete horas de diferencia, el idioma y distintas culturas.',
	},
	{
		label: '2026',
		rotation: '1.5deg',
		image: placeholderSrc,
		text: 'Con la paciencia que tanto caracteriza a Chris, fuimos encontrando la manera de acercar dos mundos que parecían lejanos. No siempre fue fácil, pero cada desafío nos enseñó que el amor también se construye con esfuerzo, compromiso, y esa capacidad de tomar la decisión consciente de elegirnos cada día. Y así, el 12 de julio de 2026, en Lisboa, Portugal, dimos uno de los pasos más importantes de nuestra historia: decidir compartir el resto de nuestras vidas.',
	},
	{
		label: 'Ahora',
		rotation: '-1deg',
		image: placeholderSrc,
		text: 'Desde entonces, con amor, paciencia y la firme decisión de caminar juntos, hemos comenzado a construir, paso a paso, esa vida que tanto soñamos. Porque si algo nos han enseñado, nuestra historia y la vida, es que el amor no consiste en encontrar un camino perfecto, sino en encontrar a alguien con quien quieras recorrerlo todo, confiando en que, de la mano de Dios, siempre encontraremos el camino.',
	},
] as const;
---

<section
	id="nuestra-historia"
	class="our-story"
	aria-label="Nuestra historia"
	data-our-story
>
	<div class="our-story__sticky">
		<div class="our-story__layout">
			<h2 class="our-story__title" data-reveal>
				<span class="our-story__title-line">Nuestra</span>
				<span class="our-story__title-line">historia</span>
			</h2>

			<div class="our-story__stage" aria-hidden="true">
				<div class="our-story__stack" data-stack style="--entered: 1">
					{
						milestones.map((item, index) => (
							<article
								class="our-story__polaroid"
								style={`--rot: ${item.rotation}; --enter: ${index === 0 ? 1 : 0}; --fan: ${index}; --active: ${index === 0 ? 1 : 0};`}
								data-polaroid={index}
								data-tilt
							>
								<div class="our-story__photo">
									<img
										src={item.image}
										alt=""
										width="800"
										height="800"
										loading="lazy"
										draggable="false"
									/>
								</div>
								<p class="our-story__caption font-handlee">{item.label}</p>
							</article>
						))
					}
				</div>
			</div>

			<div class="our-story__narrative" data-narrative aria-live="polite">
				{
					milestones.map((item, index) => (
						<p
							class="our-story__text"
							data-story-text={index}
							style={`--text-active: ${index === 0 ? 1 : 0};`}
							aria-hidden={index === 0 ? 'false' : 'true'}
						>
							{item.text}
						</p>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	.our-story {
		position: relative;
		height: 300vh;
		background: var(--color-white);
	}

	.our-story__sticky {
		position: sticky;
		top: var(--header-height);
		display: flex;
		align-items: center;
		justify-content: center;
		height: calc(100svh - var(--header-height));
		width: 100%;
		overflow: hidden;
		box-sizing: border-box;
		/* Extra room so polaroid tilt shadows aren't shaved by sticky overflow */
		padding: 1.1rem 1.15rem 1.6rem;
	}

	.our-story__layout {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		justify-content: flex-start;
		/* Bigger gaps between title / photos / text */
		gap: 1.55rem;
		width: 100%;
		max-width: 90rem;
		margin-inline: auto;
		height: auto;
		max-height: 100%;
		min-height: 0;
	}

	.our-story__title {
		margin: 0;
		flex-shrink: 0;
		font-family: var(--font-serif);
		font-weight: 400;
		font-size: clamp(1.55rem, 5.5vw, 1.85rem);
		line-height: 1.1;
		letter-spacing: -0.01em;
		color: var(--color-accent);
		text-align: center;
	}

	.our-story__title-line {
		display: inline;
	}

	.our-story__title-line + .our-story__title-line::before {
		content: ' ';
	}

	.our-story__stage {
		display: flex;
		align-items: center;
		justify-content: center;
		flex: 0 0 auto;
		min-height: 0;
		width: 100%;
		overflow: visible;
		padding: 0.15rem 0;
		perspective: 1000px;
	}

	.our-story__stack {
		position: relative;
		/* Wide enough for a 3-card fan like the mobile reference */
		width: min(100%, 18.75rem);
		aspect-ratio: 2.15 / 1;
		/* Keep the visible card group centered as cards enter one by one */
		--entered: 1;
		transform: translateX(calc((3 - var(--entered, 1)) * 13.5%));
		transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.our-story__polaroid {
		--tilt-x: 0deg;
		--tilt-y: 0deg;
		--shadow-x: 0px;
		--shadow-y: 12px;
		position: absolute;
		top: 0;
		/* Fan slots — partial overlap, not full cover */
		left: calc(var(--fan, 0) * 27.5%);
		width: 44%;
		right: auto;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding: 0.4rem 0.4rem 0.5rem;
		background: var(--color-white);
		box-shadow:
			0 1px 2px rgb(52 64 40 / 6%),
			var(--shadow-x) var(--shadow-y) 22px rgb(52 64 40 / 14%);
		/* Slide in one-by-one from the right into the fan */
		opacity: 1;
		transform: translate3d(calc((1 - var(--enter, 0)) * 110vw), 0, 0)
			perspective(1000px) rotateX(var(--tilt-x)) rotateY(var(--tilt-y))
			rotate(var(--rot, 0deg)) scale(calc(0.97 + var(--active, 0) * 0.03));
		transform-style: preserve-3d;
		z-index: calc(1 + var(--fan, 0) + var(--active, 0) * 3);
		will-change: transform, box-shadow;
		pointer-events: none;
		user-select: none;
	}

	@media (hover: hover) and (pointer: fine) {
		.our-story__polaroid {
			pointer-events: auto;
		}
	}

	.our-story__photo {
		position: relative;
		width: 100%;
		aspect-ratio: 1;
		overflow: hidden;
		background: color-mix(in srgb, var(--color-muted) 35%, var(--color-surface));
		transform-style: preserve-3d;
	}

	.our-story__photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		/* Softer nested parallax — inherits --tilt-* from the polaroid */
		transform: perspective(800px) rotateX(calc(var(--tilt-x, 0deg) * 0.4))
			rotateY(calc(var(--tilt-y, 0deg) * 0.4)) scale(1.06);
		will-change: transform;
	}

	.our-story__caption {
		margin: 0;
		text-align: center;
		font-size: clamp(0.95rem, 2.8vw, 1.1rem);
		line-height: 1;
		color: color-mix(in srgb, var(--color-accent) 78%, #6b5a4a);
	}

	.our-story__narrative {
		position: relative;
		display: grid;
		align-items: start;
		flex: 0 1 auto;
		width: 100%;
		min-height: 0;
		max-height: none;
	}

	.our-story__text {
		grid-area: 1 / 1;
		position: relative;
		margin: 0;
		overflow: visible;
		/* Match FAQ open-answer typography exactly */
		font-family: var(--font-sans);
		font-size: 0.9375rem;
		font-weight: 400;
		line-height: 1.7;
		color: color-mix(in srgb, var(--color-accent) 72%, #fff);
		text-align: justify;
		text-justify: inter-word;
		hyphens: none;
		opacity: var(--text-active, 0);
		transform: translate3d(0, calc((1 - var(--text-active, 0)) * 0.35rem), 0);
		transition:
			opacity 0.45s cubic-bezier(0.22, 1, 0.36, 1),
			transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
		will-change: opacity, transform;
		pointer-events: none;
	}

	.our-story__text[aria-hidden='false'] {
		pointer-events: auto;
	}

	@media (min-width: 1024px) {
		.our-story__sticky {
			align-items: center;
			justify-content: center;
			padding: 1.5rem 3rem 2rem;
		}

		.our-story__layout {
			display: grid;
			grid-template-columns: minmax(11rem, 0.28fr) minmax(16rem, 0.34fr) minmax(16rem, 0.38fr);
			align-items: center;
			column-gap: clamp(2rem, 5vw, 4.5rem);
			height: auto;
			max-height: 100%;
		}

		.our-story__title {
			justify-self: start;
			text-align: left;
			font-size: clamp(2.35rem, 3.6vw, 3.35rem);
		}

		.our-story__title-line {
			display: block;
		}

		.our-story__title-line + .our-story__title-line::before {
			content: none;
		}

		.our-story__stage {
			flex: unset;
			width: auto;
			overflow: visible;
			padding: 1.5rem;
		}

		.our-story__stack {
			width: min(100%, 20.5rem);
			aspect-ratio: 4 / 4.85;
			margin-inline: auto;
			transform: none;
			transition: none;
		}

		.our-story__polaroid {
			left: 0;
			right: 0;
			width: auto;
			padding: 0.85rem 0.85rem 1rem;
			gap: 0.7rem;
			z-index: calc(1 + var(--fan, 0));
			/* Rise from below the viewport so cards feel like they enter the screen */
			transform: translate3d(0, calc((1 - var(--enter, 0)) * 110vh), 0)
				perspective(1000px) rotateX(var(--tilt-x)) rotateY(var(--tilt-y))
				rotate(var(--rot, 0deg));
		}

		.our-story__caption {
			font-size: 1.45rem;
		}

		.our-story__narrative {
			align-items: center;
			flex: unset;
			width: 100%;
			max-width: 28rem;
			justify-self: start;
			align-self: center;
		}

	}

	@media (min-width: 1280px) {
		.our-story__sticky {
			padding-inline: 4.5rem;
		}

		.our-story__stack {
			width: min(100%, 22rem);
		}
	}

	@media (max-height: 720px) and (max-width: 1023px) {
		.our-story__layout {
			gap: 1.15rem;
		}

		.our-story__stack {
			width: min(100%, 16.5rem);
			aspect-ratio: 2.2 / 1;
		}

		.our-story__polaroid {
			width: 42%;
			left: calc(var(--fan, 0) * 29%);
			padding: 0.35rem 0.35rem 0.45rem;
		}

	}

	@media (prefers-reduced-motion: reduce) {
		.our-story {
			height: auto;
		}

		.our-story__sticky {
			position: relative;
			height: auto;
			overflow: visible;
			padding-block: 3.5rem;
		}

		.our-story__layout {
			height: auto;
			gap: 2rem;
		}

		.our-story__stack {
			aspect-ratio: auto;
			height: auto;
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 1.5rem;
		}

		.our-story__stage {
			overflow: visible;
			padding: 0;
		}

		.our-story__polaroid {
			position: relative;
			inset: auto;
			left: auto;
			width: min(100%, 8.5rem);
			opacity: 1;
			transform: perspective(1000px) rotateX(var(--tilt-x)) rotateY(var(--tilt-y))
				rotate(var(--rot, 0deg));
			will-change: auto;
		}

		.our-story__narrative {
			position: static;
			max-height: none;
			width: min(100%, 36rem);
			display: flex;
			flex-direction: column;
			gap: 1.25rem;
		}

		.our-story__text {
			position: static;
			opacity: 1;
			transform: none;
			will-change: auto;
			pointer-events: auto;
		}

		@media (min-width: 1024px) {
			.our-story__layout {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
			}

			.our-story__stack {
				flex-direction: row;
				flex-wrap: wrap;
				justify-content: flex-start;
				width: 100%;
			}
		}
	}
</style>

<script>
	function clamp(value: number, min: number, max: number) {
		return Math.min(max, Math.max(min, value));
	}

	function easeInOutCubic(t: number) {
		return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
	}

	/** Map overall scroll progress to each card’s enter amount (0 → 1). */
	function cardEnter(progress: number, index: number, count: number) {
		if (index === 0) return 1;
		const segments = Math.max(1, count - 1);
		const start = (index - 1) / segments;
		const end = index / segments;
		// Animate in the first ~70% of the segment; hold for the rest
		const span = (end - start) * 0.7;
		const t = clamp((progress - start) / span, 0, 1);
		return easeInOutCubic(t);
	}

	function activeTextIndex(progress: number, count: number) {
		let active = 0;
		for (let i = 1; i < count; i++) {
			if (cardEnter(progress, i, count) >= 0.55) active = i;
		}
		return active;
	}

	function initOurStory(root: HTMLElement) {
		const sticky = root.querySelector<HTMLElement>('.our-story__sticky');
		const stack = root.querySelector<HTMLElement>('[data-stack]');
		const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-polaroid]'));
		const texts = Array.from(root.querySelectorAll<HTMLElement>('[data-story-text]'));
		if (!sticky || !cards.length || !texts.length) return;

		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		if (reduceMotion.matches) {
			cards.forEach((card) => card.style.setProperty('--enter', '1'));
			texts.forEach((text, i) => {
				text.style.setProperty('--text-active', '1');
				text.setAttribute('aria-hidden', 'false');
				text.id = i === 0 ? 'our-story-active-text' : '';
			});
			return;
		}

		let ticking = false;
		let lockedScrollable: number | null = null;

		const measureScrollable = () => Math.max(1, root.offsetHeight - sticky.offsetHeight);

		const headerOffset = () => {
			const raw = getComputedStyle(document.documentElement)
				.getPropertyValue('--header-height')
				.trim();
			if (raw.endsWith('rem')) {
				const rem = Number.parseFloat(raw);
				const root = Number.parseFloat(getComputedStyle(document.documentElement).fontSize);
				return Number.isFinite(rem) && Number.isFinite(root) ? rem * root : 0;
			}
			const px = Number.parseFloat(raw);
			return Number.isFinite(px) ? px : 0;
		};

		const update = () => {
			ticking = false;
			const rect = root.getBoundingClientRect();
			const header = headerOffset();
			const active = rect.top <= header && rect.bottom >= header + sticky.offsetHeight;

			if (active) {
				lockedScrollable ??= measureScrollable();
			} else if (rect.top > header) {
				lockedScrollable = null;
			}

			const scrollable = lockedScrollable ?? measureScrollable();
			const progress = clamp((header - rect.top) / scrollable, 0, 1);
			const count = cards.length;

			const textIndex = activeTextIndex(progress, count);
			let entered = 1;
			for (let i = 1; i < count; i++) {
				if (cardEnter(progress, i, count) >= 0.45) entered = i + 1;
			}

			stack?.style.setProperty('--entered', String(entered));

			cards.forEach((card, index) => {
				card.style.setProperty('--enter', String(cardEnter(progress, index, count)));
				card.style.setProperty('--active', index === textIndex ? '1' : '0');
			});

			texts.forEach((text, index) => {
				const on = index === textIndex ? 1 : 0;
				text.style.setProperty('--text-active', String(on));
				text.setAttribute('aria-hidden', on ? 'false' : 'true');
			});
		};

		const onScroll = () => {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(update);
		};

		const onResize = () => {
			lockedScrollable = null;
			onScroll();
		};

		update();
		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', onResize, { passive: true });
	}

	document.querySelectorAll<HTMLElement>('[data-our-story]').forEach(initOurStory);
</script>
