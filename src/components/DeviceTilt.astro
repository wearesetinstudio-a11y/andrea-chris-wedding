---
/**
 * Boots the shared tilt system for all [data-tilt] physical cards.
 * @see ../scripts/useTiltEffect.ts
 */
---

<script>
	import { initTiltEffect } from '../scripts/useTiltEffect';

	const boot = () => initTiltEffect();

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', boot, { once: true });
	} else {
		boot();
	}
</script>
