---
/**
 * - [data-menu-tilt]: desktop cursor 3D tilt (Gastronomía / polaroids)
 * - [data-tilt]: mobile gyroscope tilt (letter, etc. — not menu-tilt cards)
 */
---

<script>
	type OrientationPermission = {
		requestPermission?: () => Promise<'granted' | 'denied' | 'default'>;
	};

	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
	const desktop = window.matchMedia('(min-width: 1024px)');
	const coarsePointer = window.matchMedia('(pointer: coarse)');

	const clamp = (value: number, min: number, max: number) =>
		Math.min(max, Math.max(min, value));

	const lerp = (from: number, to: number, amount: number) => from + (to - from) * amount;

	const writeTilt = (el: HTMLElement, x: number, y: number) => {
		el.style.setProperty('--tilt-x', `${x.toFixed(2)}deg`);
		el.style.setProperty('--tilt-y', `${y.toFixed(2)}deg`);
	};

	const writeShadow = (el: HTMLElement, x: number, y: number, max: number, shadow: number) => {
		el.style.setProperty('--shadow-x', `${(-y * (shadow / max)).toFixed(2)}px`);
		el.style.setProperty('--shadow-y', `${(14 + x * (shadow / max)).toFixed(2)}px`);
	};

	/** Desktop cursor tilt — same behavior as original Gastronomía cards. */
	function initCardCursorTilt() {
		const MAX = 4.5;
		const LERP = 0.16;
		const SHADOW = 14;

		type CardState = {
			el: HTMLElement;
			targetX: number;
			targetY: number;
			currentX: number;
			currentY: number;
			active: boolean;
		};

		const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-menu-tilt]'));
		if (!cards.length) return;

		const states: CardState[] = cards.map((el) => ({
			el,
			targetX: 0,
			targetY: 0,
			currentX: 0,
			currentY: 0,
			active: false,
		}));

		let rafId = 0;
		let running = false;

		const enabled = () =>
			desktop.matches && finePointer.matches && !reduceMotion.matches;

		const apply = (state: CardState) => {
			writeTilt(state.el, state.currentX, state.currentY);
			writeShadow(state.el, state.currentX, state.currentY, MAX, SHADOW);
		};

		const tick = () => {
			let busy = false;

			for (const state of states) {
				state.currentX = lerp(state.currentX, state.targetX, LERP);
				state.currentY = lerp(state.currentY, state.targetY, LERP);
				if (Math.abs(state.currentX - state.targetX) < 0.01) state.currentX = state.targetX;
				if (Math.abs(state.currentY - state.targetY) < 0.01) state.currentY = state.targetY;
				apply(state);

				if (
					state.active ||
					state.currentX !== 0 ||
					state.currentY !== 0 ||
					state.targetX !== 0 ||
					state.targetY !== 0
				) {
					busy = true;
				}
			}

			if (!busy) {
				running = false;
				rafId = 0;
				return;
			}

			rafId = requestAnimationFrame(tick);
		};

		const startLoop = () => {
			if (running) return;
			running = true;
			rafId = requestAnimationFrame(tick);
		};

		for (const state of states) {
			state.el.addEventListener('pointermove', (event) => {
				if (!enabled() || event.pointerType !== 'mouse') return;

				const rect = state.el.getBoundingClientRect();
				if (rect.width < 1 || rect.height < 1) return;

				const px = (event.clientX - rect.left) / rect.width - 0.5;
				const py = (event.clientY - rect.top) / rect.height - 0.5;

				state.targetX = clamp(-py * 2 * MAX, -MAX, MAX);
				state.targetY = clamp(px * 2 * MAX, -MAX, MAX);
				state.active = true;
				startLoop();
			});

			state.el.addEventListener('pointerleave', () => {
				state.targetX = 0;
				state.targetY = 0;
				state.active = false;
				startLoop();
			});
		}

		const resetAll = () => {
			if (enabled()) return;
			for (const state of states) {
				state.targetX = 0;
				state.targetY = 0;
				state.currentX = 0;
				state.currentY = 0;
				state.active = false;
				apply(state);
			}
		};

		desktop.addEventListener('change', resetAll);
		finePointer.addEventListener('change', resetAll);
		reduceMotion.addEventListener('change', resetAll);

		window.addEventListener(
			'pagehide',
			() => {
				if (rafId) cancelAnimationFrame(rafId);
			},
			{ once: true },
		);
	}

	/** Mobile gyro for plain [data-tilt] only (letter assembly). */
	function initGyroTilt() {
		if (reduceMotion.matches || !coarsePointer.matches) return;

		const MAX_TILT = 7.5;
		const LERP = 0.12;

		let targetX = 0;
		let targetY = 0;
		let currentX = 0;
		let currentY = 0;
		let rafId = 0;
		let running = false;
		let permissionAsked = false;

		const targets = () =>
			Array.from(document.querySelectorAll<HTMLElement>('[data-tilt]:not([data-menu-tilt])'));

		const tick = () => {
			currentX = lerp(currentX, targetX, LERP);
			currentY = lerp(currentY, targetY, LERP);
			if (Math.abs(currentX - targetX) < 0.01) currentX = targetX;
			if (Math.abs(currentY - targetY) < 0.01) currentY = targetY;

			targets().forEach((el) => writeTilt(el, currentX, currentY));

			const idle =
				currentX === targetX &&
				currentY === targetY &&
				targetX === 0 &&
				targetY === 0;

			if (idle) {
				running = false;
				rafId = 0;
				return;
			}

			rafId = requestAnimationFrame(tick);
		};

		const startLoop = () => {
			if (running) return;
			running = true;
			rafId = requestAnimationFrame(tick);
		};

		const onOrientation = (event: DeviceOrientationEvent) => {
			const beta = event.beta ?? 0;
			const gamma = event.gamma ?? 0;
			targetX = clamp(beta / 14, -MAX_TILT, MAX_TILT);
			targetY = clamp(gamma / 12, -MAX_TILT, MAX_TILT);
			startLoop();
		};

		const enableGyro = async () => {
			if (permissionAsked) return;
			permissionAsked = true;

			const Orientation = DeviceOrientationEvent as unknown as OrientationPermission;
			try {
				if (typeof Orientation.requestPermission === 'function') {
					const state = await Orientation.requestPermission();
					if (state !== 'granted') return;
				}
				window.addEventListener('deviceorientation', onOrientation, { passive: true });
			} catch {
				/* ignore */
			}
		};

		window.addEventListener('pointerdown', () => void enableGyro(), {
			once: true,
			passive: true,
		});
		window.addEventListener('touchstart', () => void enableGyro(), {
			once: true,
			passive: true,
		});

		const Orientation = DeviceOrientationEvent as unknown as OrientationPermission;
		if (typeof Orientation.requestPermission !== 'function') {
			window.addEventListener('deviceorientation', onOrientation, { passive: true });
		}

		window.addEventListener(
			'pagehide',
			() => {
				if (rafId) cancelAnimationFrame(rafId);
			},
			{ once: true },
		);
	}

	const boot = () => {
		initCardCursorTilt();
		initGyroTilt();
	};

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', boot, { once: true });
	} else {
		boot();
	}
</script>
