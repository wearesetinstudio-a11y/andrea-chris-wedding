---
/**
 * Scroll-driven invitation: sticky two-column layout with a letter
 * that pulls out from a layered envelope as the user scrolls.
 */
---

<section
	id="invitacion"
	class="letter-pull"
	aria-label="Invitación a la boda civil"
	data-letter-pull
>
	<div class="letter-pull__sticky">
		<div class="letter-pull__grid">
			<div class="letter-pull__copy">
				<h2 class="letter-pull__title" data-reveal>
					<span class="letter-pull__title-line">Les invitamos</span>
					<span class="letter-pull__title-line">a nuestra boda civil!</span>
				</h2>
				<a href="#rsvp" class="letter-pull__cta" data-btn-press> Confirma su presencia </a>
			</div>

			<div
				class="letter-pull__stage"
				data-envelope-tap
				role="button"
				tabindex="0"
				aria-label="Abrir la invitación"
			>
				<div class="letter-pull__tilt" data-menu-tilt>
					<div class="letter-pull__clip">
						<div class="letter-pull__assembly">
							<img
								class="letter-pull__back"
								src="/images/envelope-back.png"
								alt=""
								width="940"
								height="1024"
								draggable="false"
							/>

							<img
								class="letter-pull__letter"
								src="/images/letter.webp"
								alt=""
								width="723"
								height="1024"
								draggable="false"
								data-letter
							/>

							<img
								class="letter-pull__front"
								src="/images/envelope-front.png"
								alt=""
								width="940"
								height="1024"
								draggable="false"
							/>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.letter-pull {
		position: relative;
		height: 300vh;
		background: var(--color-surface);
	}

	.letter-pull__sticky {
		position: sticky;
		/* Sit below the fixed site header so the title isn't clipped on real mobile */
		top: var(--header-height);
		display: flex;
		align-items: center;
		/* svh only — dvh jumps when mobile browser chrome shows/hides mid-scroll */
		height: calc(100svh - var(--header-height));
		width: 100%;
		overflow: hidden;
		/* Match FAQ / Footer / RSVP horizontal inset; keep clear space above next section */
		padding: 0.75rem 1.15rem 2rem;
		box-sizing: border-box;
	}

	.letter-pull__grid {
		display: grid;
		grid-template-columns: 1fr;
		align-items: center;
		justify-items: center;
		/* Tight title→envelope so the rising letter can pass over the title */
		gap: 0.15rem;
		width: 100%;
		max-height: 100%;
	}

	/* Expose title + CTA as grid children so CTA can sit under the letter on mobile */
	.letter-pull__copy {
		display: contents;
	}

	.letter-pull__title {
		order: 1;
		margin: 0;
		font-family: var(--font-serif);
		font-weight: 400;
		font-size: clamp(1.45rem, 5.2vw, 2.1rem);
		line-height: 1.15;
		letter-spacing: -0.01em;
		color: var(--color-accent);
		text-align: center;
		/* Sit under the letter layer as it rises */
		position: relative;
		z-index: 1;
		flex-shrink: 0;
	}

	.letter-pull__title-line {
		display: block;
		white-space: nowrap;
	}

	.letter-pull__cta {
		order: 3;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		margin-top: 1.25rem;
		padding: 0.85rem 1.15rem;
		background: var(--color-button);
		color: var(--color-white);
		font-family: var(--font-sans);
		font-size: 0.9375rem;
		font-weight: 300;
		line-height: 1;
		letter-spacing: 0.01em;
		white-space: nowrap;
		transition: background-color 0.2s ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.letter-pull__cta:hover,
		.letter-pull__cta:focus-visible {
			background: var(--color-button-hover);
		}
	}

	.letter-pull__cta:active,
	.letter-pull__cta.is-pressed {
		background: var(--color-button-hover);
	}

	.letter-pull__stage {
		order: 2;
		display: flex;
		justify-content: center;
		align-items: center;
		width: 100%;
		min-width: 0;
		position: relative;
		z-index: 3;
		/* Pull envelope up so the letter travels over the title while scrolling */
		margin-top: -5rem;
		-webkit-tap-highlight-color: transparent;
		outline: none;
	}

	@media (max-width: 767px) {
		.letter-pull__stage {
			cursor: pointer;
		}
	}

	/*
	 * Tilt shell sits outside the letter clip so drop-shadow isn't cut,
	 * and the whole flat envelope+letter sandwich rotates as one piece
	 * (avoids the letter poking out under the pocket during 3D tilt).
	 */
	.letter-pull__tilt {
		--tilt-x: 0deg;
		--tilt-y: 0deg;
		--shadow-x: 0px;
		--shadow-y: 14px;
		position: relative;
		/* Fill stage so nested % widths have a real containing block */
		width: 100%;
		display: flex;
		justify-content: center;
		align-items: center;
		box-sizing: border-box;
		padding: 1.75rem;
		transform: perspective(1000px) rotateX(var(--tilt-x)) rotateY(var(--tilt-y));
		filter: drop-shadow(var(--shadow-x) var(--shadow-y) 20px rgb(16 30 11 / 16%));
		will-change: transform, filter;
	}

	/* Extra headroom so the card can rise above the flap; bottom clips the tucked letter */
	.letter-pull__clip {
		position: relative;
		flex: 0 0 auto;
		width: min(88vw, 24rem);
		aspect-ratio: 940 / 1500;
		overflow: hidden;
		display: flex;
		align-items: flex-end;
		justify-content: center;
	}

	.letter-pull__assembly {
		position: relative;
		width: 100%;
		aspect-ratio: 940 / 1024;
		isolation: isolate;
		/* Flatten stacking so z-index keeps letter between back + front pocket */
		transform-style: flat;
	}

	.letter-pull__back,
	.letter-pull__front {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: contain;
		pointer-events: none;
		user-select: none;
	}

	.letter-pull__back {
		z-index: 10;
	}

	.letter-pull__front {
		z-index: 30;
	}

	/*
	 * Letter sits between back (z-10) and front pocket (z-30).
	 * --pull 1→0 maps tucked → drawn. End rests with PANAMONTE just
	 * above the pocket lip (card bottom still tucked inside).
	 */
	.letter-pull__letter {
		position: absolute;
		z-index: 20;
		left: 50%;
		top: 0;
		width: 90%;
		height: auto;
		transform: translate3d(-50%, calc(-40% + var(--pull, 1) * 62%), 0);
		filter: drop-shadow(0 6px 10px rgb(16 30 11 / 10%));
		will-change: transform;
		pointer-events: none;
		user-select: none;
	}

	@media (min-width: 768px) {
		.letter-pull__sticky {
			/* Keep large bottom clearance for the envelope; top stays modest */
			padding: 2.5rem 1.5rem 16rem 3.5rem;
		}

		.letter-pull__grid {
			/* Match FAQ two-column proportions */
			grid-template-columns: minmax(12rem, 0.38fr) minmax(0, 0.62fr);
			align-items: center;
			justify-items: stretch;
			column-gap: 3rem;
			row-gap: 0;
			max-height: none;
		}

		.letter-pull__copy {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			gap: 1.5rem;
			width: 100%;
			/* Midway between prior “too high” (2.5rem) and “too low” (align-end) */
			align-self: center;
			margin-top: 5.5rem;
		}

		.letter-pull__title {
			order: unset;
			text-align: left;
			font-size: clamp(1.65rem, 4.5vw, 2.35rem);
			z-index: auto;
		}

		.letter-pull__cta {
			order: unset;
			margin-top: 0;
		}

		.letter-pull__stage {
			order: unset;
			justify-content: center;
			z-index: auto;
			margin-top: 0;
		}

		.letter-pull__letter {
			transform: translate3d(-50%, calc(-40% + var(--pull, 1) * 62%), 0);
		}

		.letter-pull__clip {
			width: min(100%, 38rem);
		}
	}

	@media (min-width: 900px) {
		.letter-pull__sticky {
			padding-right: max(1.5rem, 2.75vw);
			padding-left: max(4.5rem, 7vw);
			padding-top: 2.5rem;
			padding-bottom: 16rem;
		}

		.letter-pull__copy {
			margin-top: 6.5rem;
		}

		.letter-pull__grid {
			column-gap: 4rem;
		}

		.letter-pull__title {
			font-size: clamp(2.35rem, 3.2vw, 3.15rem);
		}

		.letter-pull__clip {
			width: min(100%, 46rem);
		}
	}

	@media (max-height: 700px) and (min-width: 768px) {
		.letter-pull__clip {
			width: min(100%, 30rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.letter-pull {
			height: auto;
		}

		.letter-pull__sticky {
			position: relative;
			height: auto;
			min-height: auto;
			padding-block: 3.5rem;
		}

		.letter-pull__letter {
			--pull: 0.15;
			will-change: auto;
		}
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>('[data-btn-press]').forEach((btn) => {
		btn.addEventListener('touchstart', () => btn.classList.add('is-pressed'), { passive: true });
		btn.addEventListener('touchend', () => btn.classList.remove('is-pressed'));
		btn.addEventListener('touchcancel', () => btn.classList.remove('is-pressed'));
	});

	function clamp(value: number, min: number, max: number) {
		return Math.min(max, Math.max(min, value));
	}

	function initLetterPull(root: HTMLElement) {
		const letter = root.querySelector<HTMLElement>('[data-letter]');
		const sticky = root.querySelector<HTMLElement>('.letter-pull__sticky');
		const stage = root.querySelector<HTMLElement>('[data-envelope-tap]');
		if (!letter || !sticky) return;

		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		if (reduceMotion.matches) {
			letter.style.setProperty('--pull', '0.15');
			return;
		}

		let ticking = false;
		/** Locked while the section is sticky-active so URL-bar resize can't snap progress */
		let lockedScrollable: number | null = null;
		/** Ignore duplicate tap/click while a smooth scroll-open is in flight */
		let tapLockUntil = 0;

		const isMobile = () => window.matchMedia('(max-width: 767px)').matches;

		const measureScrollable = () => {
			// Prefer sticky box height (svh-stable) over window.innerHeight (jumps on mobile)
			return Math.max(1, root.offsetHeight - sticky.offsetHeight);
		};

		const headerOffset = () => {
			const raw = getComputedStyle(document.documentElement)
				.getPropertyValue('--header-height')
				.trim();
			const px = Number.parseFloat(raw);
			return Number.isFinite(px) ? px : 0;
		};

		const getProgress = () => {
			const rect = root.getBoundingClientRect();
			const header = headerOffset();
			const active = rect.top <= header && rect.bottom >= header + sticky.offsetHeight;

			if (active) {
				lockedScrollable ??= measureScrollable();
			} else if (rect.top > header) {
				lockedScrollable = null;
			}

			const scrollable = lockedScrollable ?? measureScrollable();
			return {
				progress: clamp((header - rect.top) / scrollable, 0, 1),
				scrollable,
				header,
				rect,
			};
		};

		const update = () => {
			ticking = false;
			const { progress } = getProgress();
			// 1 = tucked, 0 = fully pulled
			letter.style.setProperty('--pull', String(1 - progress));
		};

		const onScroll = () => {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(update);
		};

		const onResize = () => {
			lockedScrollable = null;
			onScroll();
		};

		/**
		 * Drive the existing scroll-linked animation with one smooth scroll.
		 * Avoids a separate --pull tween + scroll sync that replayed the open.
		 */
		const onEnvelopeActivate = () => {
			if (!isMobile()) return;
			const now = performance.now();
			if (now < tapLockUntil) return;

			const { progress, scrollable, header, rect } = getProgress();
			const sectionTop = window.scrollY + rect.top;
			tapLockUntil = now + 1200;

			if (progress < 0.92) {
				const target = sectionTop - header + scrollable;
				window.scrollTo({ top: target, behavior: 'smooth' });
			} else {
				// Already open — tuck by scrolling back to the start of the sticky runway
				window.scrollTo({ top: sectionTop - header, behavior: 'smooth' });
			}
		};

		if (stage) {
			stage.addEventListener('click', (event) => {
				if (!isMobile()) return;
				event.preventDefault();
				onEnvelopeActivate();
			});
			stage.addEventListener('keydown', (event) => {
				if (!isMobile()) return;
				if (event.key !== 'Enter' && event.key !== ' ') return;
				event.preventDefault();
				onEnvelopeActivate();
			});
		}

		update();
		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', onResize, { passive: true });
	}

	document.querySelectorAll<HTMLElement>('[data-letter-pull]').forEach(initLetterPull);
</script>
