PUBLIC_WEB3FORMS_ACCESS_KEY=

# Spotify (required for /api/spotify/* on server)
# Local: fill these in `.env` (gitignored)
# Vercel: Project Settings → Environment Variables → Production + Preview
#   SPOTIFY_CLIENT_ID
#   SPOTIFY_CLIENT_SECRET
#   SPOTIFY_REFRESH_TOKEN
#   SPOTIFY_PLAYLIST_ID
# Then redeploy. `.env` is not uploaded with the deploy.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_PLAYLIST_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:4321/callback
SPOTIFY_REFRESH_TOKEN=
